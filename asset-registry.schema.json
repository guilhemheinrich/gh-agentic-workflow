{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gh-agentic-workflow.local/asset-registry.schema.json",
  "title": "Tagged asset registry with category and bundles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assets",
    "x-tag-descriptions",
    "x-bundle-descriptions",
    "x-category-descriptions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the registry file format and content",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/assetEntry"
      }
    },
    "x-tag-descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "astro",
        "auth",
        "claude",
        "css",
        "cursor",
        "debugging",
        "docker",
        "docker-compose",
        "documentation",
        "e2e",
        "eslint",
        "fp-ts",
        "frontend",
        "git",
        "github",
        "hooks",
        "hub",
        "keycloak",
        "kubernetes",
        "lint",
        "lit",
        "lsp",
        "make",
        "mcp",
        "monorepo",
        "nestjs",
        "npm",
        "nuxt",
        "playwright",
        "prisma",
        "python",
        "react",
        "refactoring",
        "scraping",
        "security",
        "sentry",
        "shell",
        "sonarqube",
        "spec-kit",
        "sql",
        "starlight",
        "testing",
        "tdd",
        "typescript",
        "validation",
        "versioning",
        "vitest",
        "vscode",
        "vue",
        "web-components",
        "ci-cd"
      ],
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      }
    },
    "x-bundle-descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common"
      ],
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      }
    },
    "x-category-descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "standards",
        "programming-languages",
        "frameworks-and-libraries",
        "tools-and-configurations",
        "workflows-and-processes",
        "templates-and-models",
        "quality-assurance",
        "domain-specific",
        "other"
      ],
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "architecture",
        "standards",
        "programming-languages",
        "frameworks-and-libraries",
        "tools-and-configurations",
        "workflows-and-processes",
        "templates-and-models",
        "quality-assurance",
        "domain-specific",
        "other"
      ]
    },
    "bundle": {
      "type": "string",
      "enum": [
        "common"
      ]
    },
    "tag": {
      "type": "string",
      "enum": [
        "astro",
        "auth",
        "claude",
        "css",
        "cursor",
        "debugging",
        "docker",
        "docker-compose",
        "documentation",
        "e2e",
        "eslint",
        "fp-ts",
        "frontend",
        "git",
        "github",
        "hooks",
        "hub",
        "keycloak",
        "kubernetes",
        "lint",
        "lit",
        "lsp",
        "make",
        "mcp",
        "monorepo",
        "nestjs",
        "npm",
        "nuxt",
        "playwright",
        "prisma",
        "python",
        "react",
        "refactoring",
        "scraping",
        "security",
        "sentry",
        "shell",
        "sonarqube",
        "spec-kit",
        "sql",
        "starlight",
        "testing",
        "tdd",
        "typescript",
        "validation",
        "versioning",
        "vitest",
        "vscode",
        "vue",
        "web-components",
        "ci-cd"
      ]
    },
    "assetType": {
      "type": "string",
      "enum": [
        "skill",
        "command",
        "rule",
        "agent",
        "hook"
      ]
    },
    "assetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "category"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the asset. For skills, points to the skill directory (e.g. skills/my-skill/) so that companion files (references/, scripts/, templates/) are included. For other asset types, points to the file."
        },
        "type": {
          "$ref": "#/$defs/assetType"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bundle"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/00-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "architecture" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/01-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "standards" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/02-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "programming-languages" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/03-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "frameworks-and-libraries" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/04-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "tools-and-configurations" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/05-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "workflows-and-processes" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/06-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "templates-and-models" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/07-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "quality-assurance" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/08-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "domain-specific" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^rules/09-" }
            }
          },
          "then": {
            "properties": {
              "category": { "const": "other" }
            }
          }
        }
      ]
    }
  }
}
