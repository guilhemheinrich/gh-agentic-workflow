# Makefile.stub — used by Bats tests for the lint dispatch (spec 014).
# Mirrors the structure of the real root Makefile: one `lint` target with an
# inline glob→command case. Docker invocations are replaced with controllable
# stubs so the test suite runs offline.
#
# Tunables (override via env or `make` command line):
#   STUB_LINT_EXIT     — exit code returned by every routed extension (default 0).
#   STUB_LINT_OUTPUT   — text printed by every routed extension     (default "stub: ok").

STUB_LINT_EXIT   ?= 0
STUB_LINT_OUTPUT ?= stub linter: no issues

.PHONY: lint

lint:
	@F='$(FILE)'; \
	case "$$F" in \
	  '') \
	    printf 'lint: FILE=... is required\n' >&2; \
	    exit 64 ;; \
	  node_modules/*|*/node_modules/*|.git/*|*/.git/*|dist/*|*/dist/*|build/*|*/build/*|vendor/*|*/vendor/*|coverage/*|*/coverage/*) \
	    exit 0 ;; \
	  *.png|*.jpg|*.jpeg|*.svg|*.lock|*.lockb|*.env) \
	    exit 0 ;; \
	  *.broken) \
	    printf 'lint-stub: linter binary not found; wire it up before continuing.\n' >&2; \
	    exit 65 ;; \
	  *.ts|*.tsx|*.js|*.jsx|*.json|*.md|*.mdc|*.yml|*.yaml|*.sh|*.bash) \
	    printf '%s\n' '$(STUB_LINT_OUTPUT)'; \
	    exit $(STUB_LINT_EXIT) ;; \
	  *) \
	    printf 'lint router: no case matches "%s".\n' "$$F" >&2; \
	    printf 'Add a branch to the `lint:` recipe in the Makefile.\n' >&2; \
	    exit 64 ;; \
	esac
