#!/usr/bin/env bash
# Stub make binary — used by lint_on_edit.bats to control make behavior.
# Reads STUB_MAKE_EXIT (default: 0) and STUB_MAKE_OUTPUT (default: "") env vars.
STUB_MAKE_EXIT="${STUB_MAKE_EXIT:-0}"
STUB_MAKE_OUTPUT="${STUB_MAKE_OUTPUT:-}"

if [[ -n "$STUB_MAKE_OUTPUT" ]]; then
  printf '%s\n' "$STUB_MAKE_OUTPUT"
fi
exit "$STUB_MAKE_EXIT"
