# Makefile.python-uv.example
# Full Makefile for a Python project using ruff (via uv) inside an `api`
# service, plus standalone Dockerised linters for SH/MD/YAML/JSON.
# Single `lint:` target — the recipe IS the routing table (spec 014 v2.0.0).

-include .env
export

API_PORT ?= 8000

COMPOSE  = docker compose
EXEC_API = $(COMPOSE) exec -T api

.PHONY: up down test lint

# ──── Dev ──────────────────────────────────────────────────────────────────────

up: ## Start development environment
	$(COMPOSE) up -d
	@printf '  API: http://localhost:$(API_PORT)\n'

down: ## Stop development environment
	$(COMPOSE) down

test: ## Run pytest inside the api container
	$(EXEC_API) uv run pytest

# ──── Lint (spec 014 router pattern) ──────────────────────────────────────────
# The recipe is the routing table. Branch order matters — first match wins.
# `.py` is routed via the `api` container (ruff lives there via uv). Other file
# types use standalone Dockerised linters.

lint: ## Lint a single file by routing it to the right linter (FILE=path/to/file)
	@F='$(FILE)'; \
	case "$$F" in \
	  '') \
	    printf 'lint: FILE=... is required\n' >&2; \
	    exit 64 ;; \
	  .venv/*|*/.venv/*|__pycache__/*|*/__pycache__/*|.git/*|*/.git/*|dist/*|*/dist/*) \
	    exit 0 ;; \
	  *.pyc|*.pyo|*.png|*.jpg|*.svg|*.lock|*.env) \
	    exit 0 ;; \
	  *.py) \
	    exec $(EXEC_API) sh -lc \
	      'command -v ruff >/dev/null \
	      || { printf "lint: ruff not found in service api — add it to pyproject.toml dev-dependencies\n" >&2; exit 65; }; \
	      ruff check "$$0"' "$$F" ;; \
	  *.sh|*.bash) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      koalaman/shellcheck-alpine:stable shellcheck --severity=warning "$$F" ;; \
	  *.md|*.mdc) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      davidanson/markdownlint-cli2:latest "$$F" ;; \
	  *.yml|*.yaml) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      cytopia/yamllint:latest -s "$$F" ;; \
	  *.json) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      ghcr.io/jqlang/jq:latest empty "$$F" >/dev/null ;; \
	  *) \
	    printf 'lint router: no case matches "%s".\n' "$$F" >&2; \
	    printf 'Add a branch to the `lint:` recipe in the Makefile.\n' >&2; \
	    exit 64 ;; \
	esac
