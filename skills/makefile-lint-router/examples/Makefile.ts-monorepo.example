# Makefile.ts-monorepo.example
# Full Makefile for a TypeScript monorepo using Biome inside an `app` service,
# plus standalone Dockerised linters for MD/YAML/SH.
# Single `lint:` target — the recipe IS the routing table (spec 014 v2.0.0).

-include .env
export

APP_PORT ?= 3000

COMPOSE  = docker compose
EXEC_APP = $(COMPOSE) exec -T app

.PHONY: up down test lint

# ──── Dev ──────────────────────────────────────────────────────────────────────

up: ## Start development environment
	$(COMPOSE) up -d
	@printf '  App: http://localhost:$(APP_PORT)\n'

down: ## Stop development environment
	$(COMPOSE) down

test: ## Run unit + integration tests inside the app container
	$(EXEC_APP) pnpm test

# ──── Lint (spec 014 router pattern) ──────────────────────────────────────────
# The recipe is the routing table. Branch order matters — first match wins.
# Workspace branches strip the workspace prefix when handing the path to the
# in-container linter. No external dispatcher, no per-extension sub-targets.

lint: ## Lint a single file by routing it to the right linter (FILE=path/to/file)
	@F='$(FILE)'; \
	case "$$F" in \
	  '') \
	    printf 'lint: FILE=... is required\n' >&2; \
	    exit 64 ;; \
	  node_modules/*|*/node_modules/*|dist/*|*/dist/*|.git/*|*/.git/*|build/*|*/build/*|coverage/*) \
	    exit 0 ;; \
	  *.png|*.jpg|*.jpeg|*.svg|*.ico|*.woff|*.woff2|*.lock|*.lockb|*.env) \
	    exit 0 ;; \
	  apps/*/*.ts|apps/*/*.tsx|apps/*/*.js|apps/*/*.jsx|apps/*/*.json) \
	    exec $(EXEC_APP) sh -lc \
	      'command -v biome >/dev/null \
	      || { printf "lint: biome not installed in service app — add it to package.json devDependencies\n" >&2; exit 65; }; \
	      biome check "$$0"' "$$F" ;; \
	  packages/*/*.ts|packages/*/*.tsx|packages/*/*.js|packages/*/*.jsx|packages/*/*.json) \
	    exec $(EXEC_APP) sh -lc \
	      'command -v biome >/dev/null \
	      || { printf "lint: biome not installed in service app\n" >&2; exit 65; }; \
	      biome check "$$0"' "$$F" ;; \
	  *.md|*.mdc) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      davidanson/markdownlint-cli2:latest "$$F" ;; \
	  *.yml|*.yaml) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      cytopia/yamllint:latest -s "$$F" ;; \
	  *.sh|*.bash) \
	    exec docker run --rm -v "$$(pwd):/work" -w /work \
	      koalaman/shellcheck-alpine:stable shellcheck --severity=warning "$$F" ;; \
	  *) \
	    printf 'lint router: no case matches "%s".\n' "$$F" >&2; \
	    printf 'Add a branch to the `lint:` recipe (workspace branch, generic extension, or IGNORE).\n' >&2; \
	    exit 64 ;; \
	esac
