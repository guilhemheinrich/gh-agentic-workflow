# Monorepo root: the single .npmrc. Contains placeholders only, never a token.
@acme:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Second scope on another registry (optional):
# @other-org:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
