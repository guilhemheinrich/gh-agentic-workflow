# syntax=docker/dockerfile:1
# Install stage with a private registry. The token comes from a BuildKit secret
# mount: it never appears in ARG/ENV, image layers or `docker history`.
FROM oven/bun:1.3-alpine AS deps
WORKDIR /app

COPY package.json bun.lock* turbo.json .npmrc ./
COPY apps/<service>/package.json apps/<service>/
# COPY packages/shared/package.json packages/shared/

# .npmrc reads ${NPM_TOKEN}; it is set for this single command only.
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN="$(cat /run/secrets/npm_token)" bun install --frozen-lockfile

# Runtime stage: no token, no .npmrc.
FROM node:22-alpine
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/<service>/ .
