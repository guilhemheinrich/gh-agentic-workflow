#!/usr/bin/env python3
"""lw — linear-watch: wake agent sessions on Linear changes.

    lw subscribe   --session ID (--project SLUG|URL | --issue TT-123) [--since 3d] [--harness H]
    lw unsubscribe --session ID (--project SLUG|URL | --issue TT-123 | --all)
    lw list        [--session ID] [--closed] [--json]

Every command takes --state-dir (default: $LW_STATE_DIR, else
~/.local/state/linear-watch). The store is one SQLite file, lw.sqlite, in that
directory; its schema is versioned with PRAGMA user_version and migrated on
open.

A subscription ties one session to one Linear target: a project (stored as its
slugId, the 12-hex suffix of the project slug) or an issue (stored as its
uppercase identifier). Subscribing twice is a no-op that renews the row.
--since is capped at 7 days: nothing older is ever delivered.

Standard library only. Errors go to stderr with exit 2.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlparse

TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
MAX_SINCE = timedelta(days=7)
DEFAULT_HARNESS = "claude-code"
DB_NAME = "lw.sqlite"

# ── schema ────────────────────────────────────────────────────────────────────
# MIGRATIONS[n] takes the store from user_version n to n + 1. Each script runs
# inside one transaction together with its user_version bump, so a crash never
# leaves a half-migrated file. Append new migrations; never edit a shipped one.
MIGRATIONS = [
    """
    CREATE TABLE subscriptions (
      id           INTEGER PRIMARY KEY,
      session      TEXT NOT NULL,
      harness      TEXT NOT NULL,
      kind         TEXT NOT NULL CHECK (kind IN ('project', 'issue')),
      target       TEXT NOT NULL,
      since        TEXT,
      created_at   TEXT NOT NULL,
      renewed_at   TEXT NOT NULL,
      closed_at    TEXT,
      close_reason TEXT
    );
    -- one open subscription per (session, target); closed rows are history
    CREATE UNIQUE INDEX subscriptions_open
      ON subscriptions (session, kind, target) WHERE closed_at IS NULL;
    CREATE INDEX subscriptions_target ON subscriptions (kind, target);

    CREATE TABLE cursors (
      kind      TEXT NOT NULL,
      target    TEXT NOT NULL,
      last_seen TEXT NOT NULL,
      PRIMARY KEY (kind, target)
    );

    CREATE TABLE issue_states (
      identifier TEXT PRIMARY KEY,
      state      TEXT NOT NULL,
      state_type TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE TABLE own_writes (
      kind  TEXT NOT NULL CHECK (kind IN ('comment', 'state')),
      ref   TEXT NOT NULL,
      value TEXT,
      at    TEXT NOT NULL,
      PRIMARY KEY (kind, ref)
    );

    -- id is the source event id (e.g. "comment:<uuid>"); one change fans out
    -- to every subscribed session, so dedup is per (session, id)
    CREATE TABLE events (
      id           TEXT NOT NULL,
      session      TEXT NOT NULL,
      ts           TEXT NOT NULL,
      text         TEXT NOT NULL,
      delivered_at TEXT,
      PRIMARY KEY (session, id)
    );
    CREATE INDEX events_pending ON events (session) WHERE delivered_at IS NULL;
    """,
]
SCHEMA_VERSION = len(MIGRATIONS)


class LwError(Exception):
    """A user-facing error: printed to stderr, exit 2."""


def now() -> datetime:
    return datetime.now(timezone.utc).replace(microsecond=0)


def fmt(ts: datetime) -> str:
    return ts.astimezone(timezone.utc).strftime(TS_FORMAT)


def default_state_dir() -> Path:
    env = os.environ.get("LW_STATE_DIR")
    if env:
        return Path(env).expanduser()
    return Path.home() / ".local" / "state" / "linear-watch"


def connect(state_dir: Path) -> sqlite3.Connection:
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    conn = sqlite3.connect(state_dir / DB_NAME, timeout=5, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout = 5000")
    conn.execute("PRAGMA journal_mode = WAL")
    migrate(conn)
    return conn


def migrate(conn: sqlite3.Connection) -> None:
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version > SCHEMA_VERSION:
        raise LwError(
            f"store schema v{version} is newer than this lw (v{SCHEMA_VERSION}); update lw"
        )
    for target in range(version, SCHEMA_VERSION):
        conn.executescript(
            f"BEGIN IMMEDIATE;\n{MIGRATIONS[target]}\nPRAGMA user_version = {target + 1};\nCOMMIT;"
        )


# ── input normalization ───────────────────────────────────────────────────────
SLUG_ID_RE = re.compile(r"^[0-9a-f]{12}$")
ISSUE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*-[0-9]+$")
DURATION_RE = re.compile(r"^([0-9]+)([smhdw])$")
UNITS = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days", "w": "weeks"}


def _path_parts(value: str) -> list[str]:
    if "://" in value:
        return [p for p in urlparse(value).path.split("/") if p]
    return [value.strip().strip("/")]


def normalize_project(value: str) -> str:
    """Reduce a project slug, slugId or URL to its slugId.

    linear.app/<ws>/project/<name>-5842ed0c2bcd/overview -> 5842ed0c2bcd
    """
    parts = _path_parts(value)
    if "project" in parts and parts.index("project") + 1 < len(parts):
        slug = parts[parts.index("project") + 1]
    elif len(parts) == 1:
        slug = parts[0]
    else:
        slug = ""
    slug_id = slug.rsplit("-", 1)[-1].lower()
    if not SLUG_ID_RE.match(slug_id):
        raise LwError(
            f"cannot find a project slugId (12 hex characters) in {value!r}; "
            "pass the project URL, its slug or its slugId"
        )
    return slug_id


def normalize_issue(value: str) -> str:
    """Reduce an issue identifier or URL to its uppercase identifier (TT-2287)."""
    parts = _path_parts(value)
    if "issue" in parts and parts.index("issue") + 1 < len(parts):
        ident = parts[parts.index("issue") + 1]
    elif len(parts) == 1:
        ident = parts[0]
    else:
        ident = ""
    if not ISSUE_RE.match(ident):
        raise LwError(f"not a Linear issue identifier or URL: {value!r} (expected e.g. TT-123)")
    return ident.upper()


def parse_duration(value: str) -> timedelta:
    """'90m', '12h', '3d', '1w' -> timedelta, capped at MAX_SINCE."""
    match = DURATION_RE.match(value.strip())
    if not match:
        raise ValueError(f"bad duration {value!r}: expected <number><s|m|h|d|w>, e.g. 3d")
    return min(timedelta(**{UNITS[match.group(2)]: int(match.group(1))}), MAX_SINCE)


def target_of(args) -> tuple[str, str]:
    if getattr(args, "project", None):
        return "project", normalize_project(args.project)
    return "issue", normalize_issue(args.issue)


# ── transport (LW-2) ──────────────────────────────────────────────────────────
# linear_api() is the only way lw talks to Linear: `linear api` (schpet/linear-cli)
# with the GraphQL document on stdin and the variables through --variables-json
# (never --variable, which turns an all-digit slugId into a number). Exit codes
# and streams are the ones measured in references/linear-cli.md:
#   0 ok (stdout) · 1 bad query, HTTP 400 (stderr JSON) · 2 usage (stderr text)
#   3 not found, HTTP 200 + errors (stdout JSON) · 4 no key / 401
#   5 unreachable, timeout, rate limit, 5xx (stderr text)
# The error class is read from the exit code first, then from the error body,
# whichever stream holds it. Rate limiting was never provoked: it is recognized
# by the RATELIMITED code (Linear's documented error) or by its wording.
#
# The key comes from the environment, else from ~/.config/linear/env (launchd
# starts the daemon with no LINEAR_API_KEY). It only ever goes into the child's
# environment: never argv, never os.environ, never a log or the status file.
# Imported here rather than at the top so this section stays self-contained.
import shutil  # noqa: E402
import subprocess  # noqa: E402

T_OK = 0
T_CREDENTIAL = 10    # no key, or Linear rejected it
T_RATE_LIMITED = 12  # back off until the next cycle
T_OTHER = 13         # anything else: bad query, not found, unreachable, garbage

# The Homebrew symlink, never its Cellar/<version> realpath that brew upgrade moves.
LINEAR_DEFAULT_BIN = "/opt/homebrew/bin/linear"
LINEAR_TIMEOUT_S = 60.0
TRANSPORT_FILE = "transport.json"
LINEAR_FAILURE_PREFIX = "✗ API request failed: "
RATE_LIMIT_RE = re.compile(r"rate.?limit|too many requests|\b429\b", re.IGNORECASE)
OPERATION_RE = re.compile(r"^\s*(?:query|mutation)\s+([A-Za-z_][A-Za-z0-9_]*)")
ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?LINEAR_API_KEY\s*=\s*(.*?)\s*$")


class TransportError(Exception):
    """A failed linear_api() call: code is T_CREDENTIAL, T_RATE_LIMITED or T_OTHER."""

    def __init__(self, code: int, message: str, query: str):
        super().__init__(f"linear api {query}: {message} (code {code})")
        self.code = code
        self.message = message
        self.query = query


_linear_bin_cache: str | None = None


def reset_linear_bin() -> None:
    """Forget the resolved binary (tests, or after installing linear)."""
    global _linear_bin_cache
    _linear_bin_cache = None


def linear_bin() -> str | None:
    """$LW_LINEAR_BIN, else LINEAR_DEFAULT_BIN, else `linear` on PATH (resolved once)."""
    global _linear_bin_cache
    env = os.environ.get("LW_LINEAR_BIN")
    if env:
        return env
    if _linear_bin_cache is None:
        if os.access(LINEAR_DEFAULT_BIN, os.X_OK):
            _linear_bin_cache = LINEAR_DEFAULT_BIN
        else:
            _linear_bin_cache = shutil.which("linear")  # keeps the PATH entry, no realpath
    return _linear_bin_cache


def load_linear_key() -> str | None:
    """LINEAR_API_KEY from the environment (empty = unset), else ~/.config/linear/env.

    The file is parsed, never sourced: `LINEAR_API_KEY=…` with an optional
    `export ` and optional quotes.
    """
    key = os.environ.get("LINEAR_API_KEY")
    if key:
        return key
    path = Path.home() / ".config" / "linear" / "env"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        match = ENV_LINE_RE.match(line)
        if not match:
            continue
        value = match.group(1)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if value:
            key = value
    return key or None


def _operation_name(query: str) -> str:
    match = OPERATION_RE.match(query)
    return match.group(1) if match else "anonymous"


def _parse_json(text: str):
    try:
        return json.loads(text)
    except ValueError:
        return None


def _error_list(body) -> list:
    if isinstance(body, dict) and isinstance(body.get("errors"), list):
        return [e for e in body["errors"] if isinstance(e, dict)]
    return []


def _classify(rc: int, stdout: str, stderr: str) -> tuple[int, str]:
    """(code, message) of a finished `linear api` run."""
    out_body, err_body = _parse_json(stdout), _parse_json(stderr)
    if rc == 0 and isinstance(out_body, dict) and "data" in out_body and not _error_list(out_body):
        return T_OK, ""
    errors = _error_list(out_body) or _error_list(err_body)
    codes = {str((e.get("extensions") or {}).get("code", "")) for e in errors}
    if errors:
        message = str(errors[0].get("message") or "GraphQL error")
    else:
        text = (stderr.strip() or stdout.strip()).splitlines()
        message = text[0] if text else ""
        message = message.removeprefix(LINEAR_FAILURE_PREFIX).strip()
        if rc == 0:
            message = "unexpected output: " + (message[:80] or "empty")
        message = message or f"exit {rc}"
    if rc == 4 or "AUTHENTICATION_ERROR" in codes:
        return T_CREDENTIAL, message
    if "RATELIMITED" in codes or RATE_LIMIT_RE.search(stderr) or RATE_LIMIT_RE.search(message):
        return T_RATE_LIMITED, message
    return T_OTHER, message


def _record_transport(state_dir: Path, field: str, value) -> None:
    """Merge one field into <state_dir>/transport.json (atomic, mode 0600)."""
    try:
        state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        status = read_transport_status(state_dir)
        status[field] = value
        tmp = state_dir / f".{TRANSPORT_FILE}.{os.getpid()}"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(status, fh, indent=2)
        os.replace(tmp, state_dir / TRANSPORT_FILE)
    except OSError:
        pass  # the status file is for doctor; never fail a call over it


def read_transport_status(state_dir: Path) -> dict:
    """{"last_ok": ts, "last_error": {"code", "message", "query", "at"}}, keys optional."""
    try:
        status = json.loads((Path(state_dir) / TRANSPORT_FILE).read_text())
    except (OSError, ValueError):
        return {}
    return status if isinstance(status, dict) else {}


def linear_api(query: str, variables: dict | None = None, *,
               state_dir: Path | None = None, timeout: float | None = None) -> dict:
    """Run one GraphQL document through `linear api` and return the parsed body.

    Raises TransportError with code T_CREDENTIAL, T_RATE_LIMITED or T_OTHER.
    The outcome is recorded in <state_dir>/transport.json for `lw doctor`.
    """
    name = _operation_name(query)
    state_dir = Path(state_dir) if state_dir else default_state_dir()
    if timeout is None:
        try:
            timeout = float(os.environ.get("LW_LINEAR_TIMEOUT") or LINEAR_TIMEOUT_S)
        except ValueError:
            timeout = LINEAR_TIMEOUT_S
    key = load_linear_key()

    def fail(code: int, message: str):
        if key:
            message = message.replace(key, "<key>")
        message = message[:300]
        _record_transport(state_dir, "last_error",
                          {"code": code, "message": message, "query": name, "at": fmt(now())})
        return TransportError(code, message, name)

    if not key:
        raise fail(T_CREDENTIAL, "no LINEAR_API_KEY in the environment nor in ~/.config/linear/env")
    binary = linear_bin()
    if not binary:
        raise fail(T_OTHER, f"linear binary not found (set LW_LINEAR_BIN; default {LINEAR_DEFAULT_BIN})")
    env = dict(os.environ, LINEAR_API_KEY=key, LINEAR_IGNORE_ENV_FILE="1")
    try:
        proc = subprocess.run(
            [binary, "api", "--variables-json", json.dumps(variables or {})],
            input=query, capture_output=True, text=True, env=env, cwd="/", timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise fail(T_OTHER, f"timed out after {timeout:g} s") from None
    except OSError as exc:
        raise fail(T_OTHER, f"cannot run {binary}: {exc.strerror or exc}") from None
    code, message = _classify(proc.returncode, proc.stdout, proc.stderr)
    if code != T_OK:
        raise fail(code, message)
    _record_transport(state_dir, "last_ok", fmt(now()))
    return json.loads(proc.stdout)


# ── commands ──────────────────────────────────────────────────────────────────
def cmd_subscribe(conn: sqlite3.Connection, args) -> int:
    kind, target = target_of(args)
    t = now()
    try:
        since = fmt(t - parse_duration(args.since)) if args.since else None
    except ValueError as exc:
        raise LwError(str(exc)) from exc
    conn.execute("BEGIN IMMEDIATE")
    row = conn.execute(
        "SELECT id, since FROM subscriptions"
        " WHERE session = ? AND kind = ? AND target = ? AND closed_at IS NULL",
        (args.session, kind, target),
    ).fetchone()
    if row is None:
        conn.execute(
            "INSERT INTO subscriptions"
            " (session, harness, kind, target, since, created_at, renewed_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?)",
            (args.session, args.harness, kind, target, since, fmt(t), fmt(t)),
        )
        verb = "subscribed"
    else:
        # keep the earliest --since: a later, narrower one must not hide
        # changes the first subscribe asked for
        kept = min(s for s in (row["since"], since) if s) if (row["since"] or since) else None
        conn.execute(
            "UPDATE subscriptions SET renewed_at = ?, since = ? WHERE id = ?",
            (fmt(t), kept, row["id"]),
        )
        since, verb = kept, "renewed"
    conn.execute("COMMIT")
    tail = f" since {since}" if since else ""
    print(f"{verb} {args.session} to {kind} {target}{tail}")
    return 0


def cmd_unsubscribe(conn: sqlite3.Connection, args) -> int:
    sql = (
        "UPDATE subscriptions SET closed_at = ?, close_reason = 'unsubscribed'"
        " WHERE session = ? AND closed_at IS NULL"
    )
    params: list = [fmt(now()), args.session]
    if not args.all:
        kind, target = target_of(args)
        sql += " AND kind = ? AND target = ?"
        params += [kind, target]
    count = conn.execute(sql, params).rowcount
    print(f"closed {count} subscription(s) of {args.session}")
    return 0


LIST_COLUMNS = (
    "session", "harness", "kind", "target", "since",
    "created_at", "renewed_at", "closed_at", "close_reason",
)


def cmd_list(conn: sqlite3.Connection, args) -> int:
    sql = f"SELECT {', '.join(LIST_COLUMNS)} FROM subscriptions WHERE 1 = 1"
    params: list = []
    if not args.closed:
        sql += " AND closed_at IS NULL"
    if args.session:
        sql += " AND session = ?"
        params.append(args.session)
    rows = [dict(r) for r in conn.execute(sql + " ORDER BY session, kind, target, id", params)]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no subscription")
        return 0
    for r in rows:
        since = f" since {r['since']}" if r["since"] else ""
        state = f" closed {r['closed_at']} ({r['close_reason']})" if r["closed_at"] else ""
        print(f"{r['session']}  {r['kind']:<7} {r['target']}{since}  renewed {r['renewed_at']}{state}")
    return 0


# ── CLI ───────────────────────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--state-dir", type=Path, default=argparse.SUPPRESS,
        help="state directory (default: $LW_STATE_DIR or ~/.local/state/linear-watch)",
    )
    parser = argparse.ArgumentParser(
        prog="lw", parents=[common], description=__doc__.split("\n\n")[0]
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("subscribe", parents=[common], help="watch a project or an issue")
    p.add_argument("--session", required=True)
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--project", metavar="SLUG|URL")
    target.add_argument("--issue", metavar="TT-123")
    p.add_argument("--since", metavar="3d", help="also deliver changes since then (max 7d)")
    p.add_argument("--harness", default=DEFAULT_HARNESS)
    p.set_defaults(func=cmd_subscribe)

    p = sub.add_parser("unsubscribe", parents=[common], help="stop watching")
    p.add_argument("--session", required=True)
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--project", metavar="SLUG|URL")
    target.add_argument("--issue", metavar="TT-123")
    target.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_unsubscribe)

    p = sub.add_parser("list", parents=[common], help="show subscriptions")
    p.add_argument("--session")
    p.add_argument("--closed", action="store_true", help="include closed subscriptions")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    state_dir = getattr(args, "state_dir", None) or default_state_dir()
    try:
        if args.command in ("subscribe", "unsubscribe") and not getattr(args, "all", False):
            target_of(args)  # validate before touching the store
        conn = connect(state_dir)
        try:
            return args.func(conn, args)
        finally:
            conn.close()
    except LwError as exc:
        print(f"lw: {exc}", file=sys.stderr)
        return 2
    except sqlite3.Error as exc:
        print(f"lw: store error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
