#!/usr/bin/env python3
"""lw — linear-watch: wake agent sessions on Linear changes.

    lw subscribe   --session ID (--project SLUG|URL | --issue TT-123) [--since 3d] [--harness H]
    lw unsubscribe --session ID (--project SLUG|URL | --issue TT-123 | --all)
    lw list        [--session ID] [--closed] [--json]

Every command takes --state-dir (default: $LW_STATE_DIR, else
~/.local/state/linear-watch). The store is one SQLite file, lw.sqlite, in that
directory; its schema is versioned with PRAGMA user_version and migrated on
open.

A subscription ties one session to one Linear target: a project (stored as its
slugId, the 12-hex suffix of the project slug) or an issue (stored as its
uppercase identifier). Subscribing twice is a no-op that renews the row.
--since is capped at 7 days: nothing older is ever delivered.

Standard library only. Errors go to stderr with exit 2.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlparse

TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
MAX_SINCE = timedelta(days=7)
DEFAULT_HARNESS = "claude-code"
DB_NAME = "lw.sqlite"

# ── schema ────────────────────────────────────────────────────────────────────
# MIGRATIONS[n] takes the store from user_version n to n + 1. Each script runs
# inside one transaction together with its user_version bump, so a crash never
# leaves a half-migrated file. Append new migrations; never edit a shipped one.
MIGRATIONS = [
    """
    CREATE TABLE subscriptions (
      id           INTEGER PRIMARY KEY,
      session      TEXT NOT NULL,
      harness      TEXT NOT NULL,
      kind         TEXT NOT NULL CHECK (kind IN ('project', 'issue')),
      target       TEXT NOT NULL,
      since        TEXT,
      created_at   TEXT NOT NULL,
      renewed_at   TEXT NOT NULL,
      closed_at    TEXT,
      close_reason TEXT
    );
    -- one open subscription per (session, target); closed rows are history
    CREATE UNIQUE INDEX subscriptions_open
      ON subscriptions (session, kind, target) WHERE closed_at IS NULL;
    CREATE INDEX subscriptions_target ON subscriptions (kind, target);

    CREATE TABLE cursors (
      kind      TEXT NOT NULL,
      target    TEXT NOT NULL,
      last_seen TEXT NOT NULL,
      PRIMARY KEY (kind, target)
    );

    CREATE TABLE issue_states (
      identifier TEXT PRIMARY KEY,
      state      TEXT NOT NULL,
      state_type TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );

    CREATE TABLE own_writes (
      kind  TEXT NOT NULL CHECK (kind IN ('comment', 'state')),
      ref   TEXT NOT NULL,
      value TEXT,
      at    TEXT NOT NULL,
      PRIMARY KEY (kind, ref)
    );

    -- id is the source event id (e.g. "comment:<uuid>"); one change fans out
    -- to every subscribed session, so dedup is per (session, id)
    CREATE TABLE events (
      id           TEXT NOT NULL,
      session      TEXT NOT NULL,
      ts           TEXT NOT NULL,
      text         TEXT NOT NULL,
      delivered_at TEXT,
      PRIMARY KEY (session, id)
    );
    CREATE INDEX events_pending ON events (session) WHERE delivered_at IS NULL;
    """,
]
SCHEMA_VERSION = len(MIGRATIONS)


class LwError(Exception):
    """A user-facing error: printed to stderr, exit 2."""


def now() -> datetime:
    return datetime.now(timezone.utc).replace(microsecond=0)


def fmt(ts: datetime) -> str:
    return ts.astimezone(timezone.utc).strftime(TS_FORMAT)


def default_state_dir() -> Path:
    env = os.environ.get("LW_STATE_DIR")
    if env:
        return Path(env).expanduser()
    return Path.home() / ".local" / "state" / "linear-watch"


def connect(state_dir: Path) -> sqlite3.Connection:
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    conn = sqlite3.connect(state_dir / DB_NAME, timeout=5, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout = 5000")
    conn.execute("PRAGMA journal_mode = WAL")
    migrate(conn)
    return conn


def migrate(conn: sqlite3.Connection) -> None:
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version > SCHEMA_VERSION:
        raise LwError(
            f"store schema v{version} is newer than this lw (v{SCHEMA_VERSION}); update lw"
        )
    for target in range(version, SCHEMA_VERSION):
        conn.executescript(
            f"BEGIN IMMEDIATE;\n{MIGRATIONS[target]}\nPRAGMA user_version = {target + 1};\nCOMMIT;"
        )


# ── input normalization ───────────────────────────────────────────────────────
SLUG_ID_RE = re.compile(r"^[0-9a-f]{12}$")
ISSUE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*-[0-9]+$")
DURATION_RE = re.compile(r"^([0-9]+)([smhdw])$")
UNITS = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days", "w": "weeks"}


def _path_parts(value: str) -> list[str]:
    if "://" in value:
        return [p for p in urlparse(value).path.split("/") if p]
    return [value.strip().strip("/")]


def normalize_project(value: str) -> str:
    """Reduce a project slug, slugId or URL to its slugId.

    linear.app/<ws>/project/<name>-5842ed0c2bcd/overview -> 5842ed0c2bcd
    """
    parts = _path_parts(value)
    if "project" in parts and parts.index("project") + 1 < len(parts):
        slug = parts[parts.index("project") + 1]
    elif len(parts) == 1:
        slug = parts[0]
    else:
        slug = ""
    slug_id = slug.rsplit("-", 1)[-1].lower()
    if not SLUG_ID_RE.match(slug_id):
        raise LwError(
            f"cannot find a project slugId (12 hex characters) in {value!r}; "
            "pass the project URL, its slug or its slugId"
        )
    return slug_id


def normalize_issue(value: str) -> str:
    """Reduce an issue identifier or URL to its uppercase identifier (TT-2287)."""
    parts = _path_parts(value)
    if "issue" in parts and parts.index("issue") + 1 < len(parts):
        ident = parts[parts.index("issue") + 1]
    elif len(parts) == 1:
        ident = parts[0]
    else:
        ident = ""
    if not ISSUE_RE.match(ident):
        raise LwError(f"not a Linear issue identifier or URL: {value!r} (expected e.g. TT-123)")
    return ident.upper()


def parse_duration(value: str) -> timedelta:
    """'90m', '12h', '3d', '1w' -> timedelta, capped at MAX_SINCE."""
    match = DURATION_RE.match(value.strip())
    if not match:
        raise ValueError(f"bad duration {value!r}: expected <number><s|m|h|d|w>, e.g. 3d")
    return min(timedelta(**{UNITS[match.group(2)]: int(match.group(1))}), MAX_SINCE)


def target_of(args) -> tuple[str, str]:
    if getattr(args, "project", None):
        return "project", normalize_project(args.project)
    return "issue", normalize_issue(args.issue)


# ── transport (LW-2) ──────────────────────────────────────────────────────────
# linear_api() is the only way lw talks to Linear: `linear api` (schpet/linear-cli)
# with the GraphQL document on stdin and the variables through --variables-json
# (never --variable, which turns an all-digit slugId into a number). Exit codes
# and streams are the ones measured in references/linear-cli.md:
#   0 ok (stdout) · 1 bad query, HTTP 400 (stderr JSON) · 2 usage (stderr text)
#   3 not found, HTTP 200 + errors (stdout JSON) · 4 no key / 401
#   5 unreachable, timeout, rate limit, 5xx (stderr text)
# The error class is read from the exit code first, then from the error body,
# whichever stream holds it. Rate limiting was never provoked: it is recognized
# by the RATELIMITED code (Linear's documented error) or by its wording.
#
# The key comes from the environment, else from ~/.config/linear/env (launchd
# starts the daemon with no LINEAR_API_KEY). It only ever goes into the child's
# environment: never argv, never os.environ, never a log or the status file.
# Imported here rather than at the top so this section stays self-contained.
import shutil  # noqa: E402
import subprocess  # noqa: E402

T_OK = 0
T_CREDENTIAL = 10    # no key, or Linear rejected it
T_RATE_LIMITED = 12  # back off until the next cycle
T_OTHER = 13         # anything else: bad query, not found, unreachable, garbage

# The Homebrew symlink, never its Cellar/<version> realpath that brew upgrade moves.
LINEAR_DEFAULT_BIN = "/opt/homebrew/bin/linear"
LINEAR_TIMEOUT_S = 60.0
TRANSPORT_FILE = "transport.json"
LINEAR_FAILURE_PREFIX = "✗ API request failed: "
RATE_LIMIT_RE = re.compile(r"rate.?limit|too many requests|\b429\b", re.IGNORECASE)
OPERATION_RE = re.compile(r"^\s*(?:query|mutation)\s+([A-Za-z_][A-Za-z0-9_]*)")
ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?LINEAR_API_KEY\s*=\s*(.*?)\s*$")


class TransportError(Exception):
    """A failed linear_api() call: code is T_CREDENTIAL, T_RATE_LIMITED or T_OTHER."""

    def __init__(self, code: int, message: str, query: str):
        super().__init__(f"linear api {query}: {message} (code {code})")
        self.code = code
        self.message = message
        self.query = query


_linear_bin_cache: str | None = None


def reset_linear_bin() -> None:
    """Forget the resolved binary (tests, or after installing linear)."""
    global _linear_bin_cache
    _linear_bin_cache = None


def linear_bin() -> str | None:
    """$LW_LINEAR_BIN, else LINEAR_DEFAULT_BIN, else `linear` on PATH (resolved once)."""
    global _linear_bin_cache
    env = os.environ.get("LW_LINEAR_BIN")
    if env:
        return env
    if _linear_bin_cache is None:
        if os.access(LINEAR_DEFAULT_BIN, os.X_OK):
            _linear_bin_cache = LINEAR_DEFAULT_BIN
        else:
            _linear_bin_cache = shutil.which("linear")  # keeps the PATH entry, no realpath
    return _linear_bin_cache


def load_linear_key() -> str | None:
    """LINEAR_API_KEY from the environment (empty = unset), else ~/.config/linear/env.

    The file is parsed, never sourced: `LINEAR_API_KEY=…` with an optional
    `export ` and optional quotes.
    """
    key = os.environ.get("LINEAR_API_KEY")
    if key:
        return key
    path = Path.home() / ".config" / "linear" / "env"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        match = ENV_LINE_RE.match(line)
        if not match:
            continue
        value = match.group(1)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if value:
            key = value
    return key or None


def _operation_name(query: str) -> str:
    match = OPERATION_RE.match(query)
    return match.group(1) if match else "anonymous"


def _parse_json(text: str):
    try:
        return json.loads(text)
    except ValueError:
        return None


def _error_list(body) -> list:
    if isinstance(body, dict) and isinstance(body.get("errors"), list):
        return [e for e in body["errors"] if isinstance(e, dict)]
    return []


def _classify(rc: int, stdout: str, stderr: str) -> tuple[int, str]:
    """(code, message) of a finished `linear api` run."""
    out_body, err_body = _parse_json(stdout), _parse_json(stderr)
    if (rc == 0 and isinstance(out_body, dict) and isinstance(out_body.get("data"), dict)
            and not _error_list(out_body)):
        return T_OK, ""
    errors = _error_list(out_body) or _error_list(err_body)
    codes = {str((e.get("extensions") or {}).get("code", "")) for e in errors}
    if errors:
        message = str(errors[0].get("message") or "GraphQL error")
        # words are matched in the messages only, never in raw JSON ("column": 429)
        wording = " ".join(str(e.get("message", "")) for e in errors)
    else:
        text = (stderr.strip() or stdout.strip()).splitlines()
        message = text[0] if text else ""
        message = message.removeprefix(LINEAR_FAILURE_PREFIX).strip()
        if rc == 0:
            message = "unexpected output: " + (message[:80] or "empty")
        message = message or f"exit {rc}"
        wording = stderr if err_body is None else message
    if rc == 4 or "AUTHENTICATION_ERROR" in codes:
        return T_CREDENTIAL, message
    if "RATELIMITED" in codes or RATE_LIMIT_RE.search(wording):
        return T_RATE_LIMITED, message
    return T_OTHER, message


def _record_transport(state_dir: Path, field: str, value) -> None:
    """Merge one field into <state_dir>/transport.json (atomic, mode 0600)."""
    try:
        state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        status = read_transport_status(state_dir)
        status[field] = value
        tmp = state_dir / f".{TRANSPORT_FILE}.{os.getpid()}"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(status, fh, indent=2)
        os.replace(tmp, state_dir / TRANSPORT_FILE)
    except OSError:
        pass  # the status file is for doctor; never fail a call over it


def read_transport_status(state_dir: Path) -> dict:
    """{"last_ok": ts, "last_error": {"code", "message", "query", "at"}}, keys optional."""
    try:
        status = json.loads((Path(state_dir) / TRANSPORT_FILE).read_text())
    except (OSError, ValueError):
        return {}
    return status if isinstance(status, dict) else {}


def linear_api(query: str, variables: dict | None = None, *,
               state_dir: Path | None = None, timeout: float | None = None) -> dict:
    """Run one GraphQL document through `linear api` and return the parsed body.

    Raises TransportError with code T_CREDENTIAL, T_RATE_LIMITED or T_OTHER.
    The outcome is recorded in <state_dir>/transport.json for `lw doctor`.
    """
    name = _operation_name(query)
    state_dir = Path(state_dir) if state_dir else default_state_dir()
    if timeout is None:
        try:
            timeout = float(os.environ.get("LW_LINEAR_TIMEOUT") or LINEAR_TIMEOUT_S)
        except ValueError:
            timeout = LINEAR_TIMEOUT_S
    key = load_linear_key()

    def fail(code: int, message: str):
        if key:
            message = message.replace(key, "<key>")
        message = message[:300]
        _record_transport(state_dir, "last_error",
                          {"code": code, "message": message, "query": name, "at": fmt(now())})
        return TransportError(code, message, name)

    if not key:
        raise fail(T_CREDENTIAL, "no LINEAR_API_KEY in the environment nor in ~/.config/linear/env")
    binary = linear_bin()
    if not binary:
        raise fail(T_OTHER, f"linear binary not found (set LW_LINEAR_BIN; default {LINEAR_DEFAULT_BIN})")
    env = dict(os.environ, LINEAR_API_KEY=key, LINEAR_IGNORE_ENV_FILE="1")
    try:
        proc = subprocess.run(
            [binary, "api", "--variables-json", json.dumps(variables or {})],
            input=query, capture_output=True, text=True, env=env, cwd="/", timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise fail(T_OTHER, f"timed out after {timeout:g} s") from None
    except OSError as exc:
        raise fail(T_OTHER, f"cannot run {binary}: {exc.strerror or exc}") from None
    code, message = _classify(proc.returncode, proc.stdout, proc.stderr)
    if code != T_OK:
        raise fail(code, message)
    _record_transport(state_dir, "last_ok", fmt(now()))
    return json.loads(proc.stdout)


# ── commands ──────────────────────────────────────────────────────────────────
def cmd_subscribe(conn: sqlite3.Connection, args) -> int:
    kind, target = target_of(args)
    t = now()
    try:
        since = fmt(t - parse_duration(args.since)) if args.since else None
    except ValueError as exc:
        raise LwError(str(exc)) from exc
    conn.execute("BEGIN IMMEDIATE")
    row = conn.execute(
        "SELECT id, since FROM subscriptions"
        " WHERE session = ? AND kind = ? AND target = ? AND closed_at IS NULL",
        (args.session, kind, target),
    ).fetchone()
    if row is None:
        conn.execute(
            "INSERT INTO subscriptions"
            " (session, harness, kind, target, since, created_at, renewed_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?)",
            (args.session, args.harness, kind, target, since, fmt(t), fmt(t)),
        )
        verb = "subscribed"
    else:
        # keep the earliest --since: a later, narrower one must not hide
        # changes the first subscribe asked for
        kept = min(s for s in (row["since"], since) if s) if (row["since"] or since) else None
        conn.execute(
            "UPDATE subscriptions SET renewed_at = ?, since = ? WHERE id = ?",
            (fmt(t), kept, row["id"]),
        )
        since, verb = kept, "renewed"
    conn.execute("COMMIT")
    tail = f" since {since}" if since else ""
    print(f"{verb} {args.session} to {kind} {target}{tail}")
    return 0


def cmd_unsubscribe(conn: sqlite3.Connection, args) -> int:
    sql = (
        "UPDATE subscriptions SET closed_at = ?, close_reason = 'unsubscribed'"
        " WHERE session = ? AND closed_at IS NULL"
    )
    params: list = [fmt(now()), args.session]
    if not args.all:
        kind, target = target_of(args)
        sql += " AND kind = ? AND target = ?"
        params += [kind, target]
    count = conn.execute(sql, params).rowcount
    print(f"closed {count} subscription(s) of {args.session}")
    return 0


LIST_COLUMNS = (
    "session", "harness", "kind", "target", "since",
    "created_at", "renewed_at", "closed_at", "close_reason",
)


def cmd_list(conn: sqlite3.Connection, args) -> int:
    sql = f"SELECT {', '.join(LIST_COLUMNS)} FROM subscriptions WHERE 1 = 1"
    params: list = []
    if not args.closed:
        sql += " AND closed_at IS NULL"
    if args.session:
        sql += " AND session = ?"
        params.append(args.session)
    rows = [dict(r) for r in conn.execute(sql + " ORDER BY session, kind, target, id", params)]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no subscription")
        return 0
    for r in rows:
        since = f" since {r['since']}" if r["since"] else ""
        state = f" closed {r['closed_at']} ({r['close_reason']})" if r["closed_at"] else ""
        print(f"{r['session']}  {r['kind']:<7} {r['target']}{since}  renewed {r['renewed_at']}{state}")
    return 0


# ── wait (LW-4) ───────────────────────────────────────────────────────────────
# `lw wait --session ID [--timeout S]` is the session's doorbell, the twin of
# `prw wait`: the session runs it in the background and its exit wakes it.
#
#   exit 0  lines printed (then a "still watching" line while subscribed)
#   exit 2  --timeout elapsed, nothing on stdout or stderr (errors also exit 2,
#           but always say why on stderr)
#   exit 3  no open subscription and nothing left to deliver
#   exit 4  another wait already runs for this session
#
# Self-contained so that the other items editing `lw` merge without conflict:
# its imports live here and build_parser() only calls register_wait().
import fcntl  # noqa: E402
import hashlib  # noqa: E402
import time  # noqa: E402

WAIT_POLL_DEFAULT = 10.0  # seconds; LW_WAIT_POLL overrides it (tests use 0.05)
WAIT_EXIT_LINES, WAIT_EXIT_TIMEOUT, WAIT_EXIT_UNWATCHED, WAIT_EXIT_BUSY = 0, 2, 3, 4
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")


def wait_poll_seconds() -> float:
    raw = os.environ.get("LW_WAIT_POLL", "")
    if not raw:
        return WAIT_POLL_DEFAULT
    try:
        value = float(raw)
    except ValueError:
        value = 0.0
    if not value > 0:
        raise LwError(f"LW_WAIT_POLL must be a positive number of seconds, got {raw!r}")
    return value


def lock_name(session: str) -> str:
    """A file name for the session's lock: the id itself when it is safe,
    else a sanitized form plus a hash so two odd ids never share a lock."""
    if SAFE_NAME_RE.match(session):
        return f"{session}.lock"
    clean = re.sub(r"[^A-Za-z0-9._-]", "_", session).strip("._")[:64] or "session"
    digest = hashlib.sha256(session.encode()).hexdigest()[:10]
    return f"{clean}-{digest}.lock"


def acquire_wait_lock(state_dir: Path, session: str) -> int | None:
    """Take the session's wait lock; None when another live wait holds it.

    flock belongs to the open file and the kernel drops it when the holder
    dies, so a killed wait never leaves a stale lock behind. The file stays
    on disk on purpose: removing it would let two waits lock two inodes.
    """
    path = state_dir / "waits" / lock_name(session)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, f"{os.getpid()}\n".encode())
    return fd


def lock_holder(state_dir: Path, session: str) -> str:
    try:
        return (state_dir / "waits" / lock_name(session)).read_text().strip()
    except OSError:
        return ""


def renew_subscriptions(conn: sqlite3.Connection, session: str, ts: str) -> int:
    """Renew the session's open subscriptions; returns how many are open."""
    return conn.execute(
        "UPDATE subscriptions SET renewed_at = ? WHERE session = ? AND closed_at IS NULL",
        (ts, session),
    ).rowcount


def wait_once(conn: sqlite3.Connection, session: str) -> int | None:
    """One poll: renew, deliver pending lines, report. None = keep waiting.

    Lines, their acknowledgement and the subscription count come from one
    write transaction, so a cycle that writes a last line and closes the
    subscription is seen whole: the line is delivered, and only the next wait
    exits 3. A line is printed before it is marked: a crash in between
    delivers it twice rather than never.
    """
    t = fmt(now())
    conn.execute("BEGIN IMMEDIATE")
    try:
        open_count = renew_subscriptions(conn, session, t)
        rows = conn.execute(
            "SELECT id, text FROM events WHERE session = ? AND delivered_at IS NULL"
            " ORDER BY ts, id",
            (session,),
        ).fetchall()
        for row in rows:
            print(row["text"], flush=True)
        if rows:
            conn.executemany(
                "UPDATE events SET delivered_at = ? WHERE session = ? AND id = ?",
                [(t, session, row["id"]) for row in rows],
            )
        conn.execute("COMMIT")
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    if rows:
        if open_count:
            print(
                f"lw: still watching {open_count} Linear subscription(s) — run "
                f"`lw wait --session {session}` again with run_in_background.",
                flush=True,
            )
        return WAIT_EXIT_LINES
    if not open_count:
        print("no open subscription", flush=True)
        return WAIT_EXIT_UNWATCHED
    return None


def cmd_wait(conn: sqlite3.Connection, args) -> int:
    if args.timeout is not None and args.timeout < 0:
        raise LwError(f"--timeout must be zero or more seconds, got {args.timeout:g}")
    poll = wait_poll_seconds()
    state_dir = Path(conn.execute("PRAGMA database_list").fetchone()["file"]).parent
    fd = acquire_wait_lock(state_dir, args.session)
    if fd is None:
        holder = lock_holder(state_dir, args.session)
        print(f"already waiting (pid {holder})" if holder else "already waiting", flush=True)
        return WAIT_EXIT_BUSY
    try:
        deadline = None if args.timeout is None else time.monotonic() + args.timeout
        while True:
            code = wait_once(conn, args.session)
            if code is not None:
                return code
            if deadline is not None:
                left = deadline - time.monotonic()
                if left <= 0:
                    return WAIT_EXIT_TIMEOUT
                time.sleep(min(poll, left))
            else:
                time.sleep(poll)
    finally:
        os.close(fd)


def register_wait(sub, common) -> None:
    p = sub.add_parser(
        "wait", parents=[common], help="block until the session has Linear lines",
        description="Print the session's undelivered lines and exit. Exit 0 lines,"
        " 2 timeout, 3 no open subscription, 4 another wait runs for this session.",
    )
    p.add_argument("--session", required=True)
    p.add_argument("--timeout", type=float, metavar="S", help="give up after S seconds (exit 2)")
    p.set_defaults(func=cmd_wait)


# ── end of wait (LW-4) ────────────────────────────────────────────────────────

# ── own writes (LW-6) ─────────────────────────────────────────────────────────
#   lw own-write --comment ID                 a comment this machine's agent wrote
#   lw own-write --issue TT-123 --state NAME  a state move this agent made
#   lw own-write --hook                       a PostToolUse payload on stdin
#
# Agent and human comments are indistinguishable in Linear (botActor is null
# on comments posted through the MCP), so the poll cycle drops what this table
# lists. Rows:
#   ('comment', <comment uuid>, NULL)          matches event id comment:<uuid>
#   ('state', <TT-123>, <state name>)          upserted on every own move
# `at` is when the row was recorded. --hook parses the payload of the Linear
# MCP save_comment / save_issue tools (tests/fixtures/mcp-responses/README.md)
# and is silent: it prints nothing and exits 0 on a bad payload.
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
OWN_WRITE_TOOL_RE = re.compile(r"^mcp__.+__(save_comment|save_issue)$")
LINEAR_URL_PREFIX = "https://linear.app/"
# keys only a Linear comment carries, next to the generic id/body/createdAt
COMMENT_MARKERS = ("quotedText", "onBehalfOf", "resolvedAt")


def _response_objects(response) -> list[dict]:
    """Every JSON object in a tool_response: content blocks, a dict, JSON text."""
    if isinstance(response, str):
        try:
            return _response_objects(json.loads(response))
        except ValueError:
            return []  # "Error: …" text of a failed call
    if isinstance(response, list):
        return [obj for item in response for obj in _response_objects(item)]
    if not isinstance(response, dict):
        return []
    if response.get("type") == "text" and isinstance(response.get("text"), str):
        return _response_objects(response["text"])
    if isinstance(response.get("content"), list) and "id" not in response:
        return _response_objects(response["content"])
    return [response]


def _is_linear_comment(obj: dict) -> bool:
    return (
        isinstance(obj.get("id"), str)
        and bool(UUID_RE.match(obj["id"].lower()))
        and isinstance(obj.get("body"), str)
        and isinstance(obj.get("createdAt"), str)
        and isinstance(obj.get("author"), dict)
        and any(key in obj for key in COMMENT_MARKERS)
    )


def _is_linear_issue(obj: dict) -> bool:
    return (
        isinstance(obj.get("id"), str)
        and bool(ISSUE_RE.match(obj["id"]))
        and isinstance(obj.get("url"), str)
        and obj["url"].startswith(LINEAR_URL_PREFIX)
        and isinstance(obj.get("status"), str)
        and bool(obj["status"].strip())
    )


def own_write_from_payload(payload) -> list[tuple[str, str, str | None]]:
    """The own_writes rows a PostToolUse payload calls for; [] for anything else.

    Another MCP server's save_comment is rejected by its mcp_server name when
    the payload carries one, otherwise by the response shape. A save_issue
    yields a row only when its input set a state; the value is the state name
    the response reports (the input may be a type or an id).
    """
    if not isinstance(payload, dict):
        return []
    if payload.get("hook_event_name", "PostToolUse") != "PostToolUse":
        return []
    tool = payload.get("tool_name")
    match = OWN_WRITE_TOOL_RE.match(tool) if isinstance(tool, str) else None
    if not match:
        return []
    server = payload.get("mcp_server")
    if isinstance(server, dict) and isinstance(server.get("name"), str):
        if "linear" not in server["name"].lower():
            return []
    objects = _response_objects(payload.get("tool_response"))
    if match.group(1) == "save_comment":
        for obj in objects:
            if _is_linear_comment(obj):
                return [("comment", obj["id"].lower(), None)]
        return []
    tool_input = payload.get("tool_input")
    if not isinstance(tool_input, dict) or tool_input.get("state") in (None, ""):
        return []
    for obj in objects:
        if _is_linear_issue(obj):
            return [("state", obj["id"].upper(), obj["status"].strip())]
    return []


def record_own_write(conn: sqlite3.Connection, kind: str, ref: str, value: str | None) -> None:
    conn.execute(
        "INSERT INTO own_writes (kind, ref, value, at) VALUES (?, ?, ?, ?)"
        " ON CONFLICT (kind, ref) DO UPDATE SET value = excluded.value, at = excluded.at",
        (kind, ref, value, fmt(now())),
    )


def cmd_own_write(conn: sqlite3.Connection, args) -> int:
    if args.hook:
        try:
            for row in own_write_from_payload(json.loads(sys.stdin.read())):
                record_own_write(conn, *row)
        except Exception:  # a hook never fails the tool call it follows
            pass
        return 0
    if args.state is not None and not args.issue:
        raise LwError("--state goes with --issue TT-123")
    if args.comment:
        comment_id = args.comment.strip().lower()
        if not UUID_RE.match(comment_id):
            raise LwError(f"not a Linear comment id (UUID): {args.comment!r}")
        record_own_write(conn, "comment", comment_id, None)
        print(f"recorded own comment {comment_id}")
        return 0
    ident = normalize_issue(args.issue)
    state = (args.state or "").strip()
    if not state:
        raise LwError("--issue needs --state NAME (the state the issue was moved to)")
    record_own_write(conn, "state", ident, state)
    print(f"recorded own state {ident} -> {state}")
    return 0


def add_own_write_parser(sub, common) -> None:
    p = sub.add_parser(
        "own-write", parents=[common],
        help="record a comment or a state move this agent made, so it never wakes anyone",
    )
    what = p.add_mutually_exclusive_group(required=True)
    what.add_argument("--comment", metavar="ID", help="comment id (UUID)")
    what.add_argument("--issue", metavar="TT-123", help="issue identifier or URL (needs --state)")
    what.add_argument(
        "--hook", action="store_true",
        help="read a Claude PostToolUse payload on stdin; silent, exit 0",
    )
    p.add_argument("--state", metavar="NAME", help="the state name the issue was moved to")
    p.set_defaults(func=cmd_own_write)


# ── poll cycle (LW-3) ─────────────────────────────────────────────────────────
#   lw daemon once     one cycle: Linear changes -> events rows; exit 1 when a
#                      query failed (its targets are retried next cycle)
#
# Per watched project: the comments created after the bound (CommentsSince)
# and the issues updated after it (IssuesUpdatedSince), whose state is compared
# with issue_states. On first sight of a project, its open issues are read
# instead (ProjectIssueStates): a silent state baseline. Every watched issue
# goes into one grouped query (WatchedIssues: state + comments since the bound).
#
# Bounds. A target's cursor is the clock at the start of its last good cycle.
# The bound is cursor - CURSOR_OVERLAP (Linear's clock and ours drift; the
# overlap is deduped by events' primary key), extended for a subscription that
# is new to the target (created at or after the cursor, or no cursor yet) down
# to its `since`, else to its created_at. Each subscription only gets what
# happened after its own floor (`since`, else created_at): a later subscriber
# without --since never hears the past, one with --since hears it once.
#
# One cycle reads everything first, then writes in one transaction: a target
# whose query failed writes nothing (no event, no state, no cursor), so its
# changes come late, never lost. A comment or a state move is fanned out to
# every open subscription on its issue or on its issue's project, whichever
# query saw it. issue_states is global: the transition of an issue is computed
# once per cycle, from its newest observation.
#
# Dropped: comments listed in own_writes, and a move to the state an own_writes
# row names when that row was recorded after the previous observation of the
# issue (minus the overlap), so a stale own move never hides a human one.
# An issue never observed before is recorded silently (new issues are out of
# scope). Comment bodies are never queried, stored nor printed.
CURSOR_OVERLAP = timedelta(seconds=120)
POLL_PAGE_SIZE = 100
POLL_MAX_PAGES = 50
ISSUE_GROUP_SIZE = 50
LINE_TEXT_MAX = 80
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f  ]")
ISSUE_LINK_RE = re.compile(r"^(https://linear\.app/[A-Za-z0-9_-]+/issue/([A-Za-z][A-Za-z0-9]*-[0-9]+))(?:[/?#].*)?$")
DONE_STATE_TYPES = '["completed", "canceled"]'

_ISSUE_FIELDS = "identifier url updatedAt state { name type } project { slugId }"
_COMMENT_FIELDS = "id createdAt user { name } botActor { name }"

PROJECT_COMMENTS_QUERY = f"""query CommentsSince($since: DateTimeOrDuration!, $p: String!, $after: String) {{
  comments(first: {POLL_PAGE_SIZE}, after: $after, orderBy: createdAt,
           filter: {{createdAt: {{gt: $since}}, issue: {{project: {{slugId: {{eq: $p}}}}}}}}) {{
    nodes {{ {_COMMENT_FIELDS} issue {{ identifier url }} }}
    pageInfo {{ hasNextPage endCursor }}
  }}
}}"""

PROJECT_ISSUES_QUERY = f"""query IssuesUpdatedSince($since: DateTimeOrDuration!, $p: String!, $after: String) {{
  issues(first: {POLL_PAGE_SIZE}, after: $after, orderBy: updatedAt,
         filter: {{updatedAt: {{gt: $since}}, project: {{slugId: {{eq: $p}}}}}}) {{
    nodes {{ {_ISSUE_FIELDS} }}
    pageInfo {{ hasNextPage endCursor }}
  }}
}}"""

PROJECT_BASELINE_QUERY = f"""query ProjectIssueStates($p: String!, $after: String) {{
  issues(first: {POLL_PAGE_SIZE}, after: $after,
         filter: {{project: {{slugId: {{eq: $p}}}}, state: {{type: {{nin: {DONE_STATE_TYPES}}}}}}}) {{
    nodes {{ {_ISSUE_FIELDS} }}
    pageInfo {{ hasNextPage endCursor }}
  }}
}}"""

# missing identifiers are simply absent from a connection filter, where one
# missing alias would null the whole `data` (references/linear-cli.md §2)
WATCHED_ISSUES_QUERY = f"""query WatchedIssues($ids: [ID!], $since: DateTimeOrDuration!) {{
  issues(first: {ISSUE_GROUP_SIZE}, filter: {{id: {{in: $ids}}}}) {{
    nodes {{
      {_ISSUE_FIELDS}
      comments(first: {POLL_PAGE_SIZE}, orderBy: createdAt, filter: {{createdAt: {{gt: $since}}}}) {{
        nodes {{ {_COMMENT_FIELDS} }}
      }}
    }}
  }}
}}"""


def parse_ts(value) -> datetime | None:
    """A Linear or lw timestamp ('…T08:44:31.713Z', '…T08:44:31Z') -> aware datetime."""
    if not isinstance(value, str) or not value:
        return None
    try:
        ts = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return ts if ts.tzinfo else ts.replace(tzinfo=timezone.utc)


def linear_ts(ts: datetime) -> str:
    """Millisecond ISO form, as Linear writes it (kept in issue_states.updated_at)."""
    return ts.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + f"{ts.microsecond // 1000:03d}Z"


def clean_text(value) -> str:
    """Third-party text (a name, a state) made safe for one wake line."""
    text = CONTROL_RE.sub(" ", str(value or ""))
    return " ".join(text.split())[:LINE_TEXT_MAX]


def issue_link(identifier: str, url) -> str:
    """The bare issue URL (no title slug, no anchor); '' when url is not Linear's."""
    match = ISSUE_LINK_RE.match(url or "") if isinstance(url, str) else None
    if match and match.group(2).upper() == identifier:
        return match.group(1)
    return ""


def _line(identifier: str, what: str, url) -> str:
    link = issue_link(identifier, url)
    return f"Linear · {identifier} {what}" + (f" · {link}" if link else "")


def _paged(query: str, variables: dict, field: str, state_dir: Path) -> list[dict]:
    """Every node of a connection, following pageInfo.endCursor."""
    nodes: list[dict] = []
    after = None
    for _ in range(POLL_MAX_PAGES):
        body = linear_api(query, {**variables, "after": after}, state_dir=state_dir)
        conn = (body.get("data") or {}).get(field) or {}
        nodes += [n for n in conn.get("nodes") or [] if isinstance(n, dict)]
        page = conn.get("pageInfo") or {}
        if not page.get("hasNextPage") or not page.get("endCursor") or page["endCursor"] == after:
            return nodes
        after = page["endCursor"]
    raise TransportError(T_OTHER, f"more than {POLL_MAX_PAGES} pages", _operation_name(query))


class CycleResult:
    def __init__(self):
        self.lines = 0
        self.sessions: set[str] = set()
        self.errors: list[TransportError] = []
        self.watched = 0


def _observation(node: dict, project: str | None = None) -> dict | None:
    ident = str(node.get("identifier") or "").upper()
    state = node.get("state") or {}
    updated = parse_ts(node.get("updatedAt"))
    if not ISSUE_RE.match(ident) or not state.get("name") or updated is None:
        return None
    project = project or ((node.get("project") or {}).get("slugId"))
    return {"identifier": ident, "url": node.get("url"), "updated": updated,
            "state": clean_text(state["name"]), "state_type": str(state.get("type") or ""),
            "project": project}


def _comment(node: dict, ident: str, url, project: str | None) -> dict | None:
    created = parse_ts(node.get("createdAt"))
    cid = str(node.get("id") or "").lower()
    if not UUID_RE.match(cid) or created is None or not ISSUE_RE.match(ident):
        return None
    author = (node.get("user") or {}).get("name") or (node.get("botActor") or {}).get("name")
    return {"id": cid, "identifier": ident.upper(), "url": url, "created": created,
            "author": clean_text(author) or "someone", "project": project}


def _bound(subs: list, cursor: datetime | None) -> datetime | None:
    """Lower bound of a target's queries; None when nothing needs fetching."""
    candidates = [cursor - CURSOR_OVERLAP] if cursor else []
    for sub in subs:
        if cursor is None or parse_ts(sub["created_at"]) >= cursor:
            candidates.append(_floor(sub))
    return min(candidates) if candidates else None


def _floor(sub) -> datetime:
    return parse_ts(sub["since"]) or parse_ts(sub["created_at"])


def _fetch_project(slug: str, subs: list, cursor: datetime | None, state_dir: Path):
    bound = _bound(subs, cursor)
    comments = []
    for node in _paged(PROJECT_COMMENTS_QUERY, {"since": fmt(bound), "p": slug}, "comments", state_dir):
        issue = node.get("issue") or {}
        item = _comment(node, str(issue.get("identifier") or "").upper(), issue.get("url"), slug)
        if item:
            comments.append(item)
    if cursor is None:
        nodes = _paged(PROJECT_BASELINE_QUERY, {"p": slug}, "issues", state_dir)
    else:
        nodes = _paged(PROJECT_ISSUES_QUERY, {"since": fmt(cursor - CURSOR_OVERLAP), "p": slug},
                       "issues", state_dir)
    observations = [o for o in (_observation(n, slug) for n in nodes) if o]
    return comments, observations


def _fetch_issues(targets: dict, state_dir: Path):
    """targets: identifier -> bound. Yields (identifiers, comments, observations)
    per group of ISSUE_GROUP_SIZE, or (identifiers, error) for a failed group."""
    idents = sorted(targets)
    for start in range(0, len(idents), ISSUE_GROUP_SIZE):
        group = idents[start:start + ISSUE_GROUP_SIZE]
        since = min(targets[i] for i in group)
        try:
            body = linear_api(WATCHED_ISSUES_QUERY, {"ids": group, "since": fmt(since)},
                              state_dir=state_dir)
        except TransportError as exc:
            yield group, exc
            continue
        comments, observations = [], []
        for node in ((body.get("data") or {}).get("issues") or {}).get("nodes") or []:
            if not isinstance(node, dict):
                continue
            obs = _observation(node)
            if not obs or obs["identifier"] not in targets:
                continue
            observations.append(obs)
            for c in ((node.get("comments") or {}).get("nodes")) or []:
                item = _comment(c, obs["identifier"], obs["url"], obs["project"]) if isinstance(c, dict) else None
                if item and item["created"] > targets[obs["identifier"]]:
                    comments.append(item)
        yield group, comments, observations


def run_cycle(conn: sqlite3.Connection, state_dir: Path) -> CycleResult:
    """One poll cycle. LW-5 runs expiry before it; LW-7 calls it in a loop."""
    result = CycleResult()
    t = now()  # the new cursor: taken before the queries, so nothing slips between
    subs = conn.execute(
        "SELECT id, session, kind, target, since, created_at FROM subscriptions"
        " WHERE closed_at IS NULL ORDER BY id"
    ).fetchall()
    by_target: dict[tuple[str, str], list] = {}
    for sub in subs:
        by_target.setdefault((sub["kind"], sub["target"]), []).append(sub)
    result.watched = len(by_target)
    if not by_target:
        return result
    cursors = {(r["kind"], r["target"]): parse_ts(r["last_seen"])
               for r in conn.execute("SELECT kind, target, last_seen FROM cursors")}

    comments: list[dict] = []
    observations: list[dict] = []
    good: list[tuple[str, str]] = []
    for (kind, target), target_subs in by_target.items():
        if kind != "project":
            continue
        try:
            found = _fetch_project(target, target_subs, cursors.get((kind, target)), state_dir)
        except TransportError as exc:
            result.errors.append(exc)
            continue
        comments += found[0]
        observations += found[1]
        good.append((kind, target))
    issue_bounds = {target: _bound(target_subs, cursors.get((kind, target)))
                    for (kind, target), target_subs in by_target.items() if kind == "issue"}
    for outcome in _fetch_issues(issue_bounds, state_dir):
        if isinstance(outcome[1], TransportError):
            result.errors.append(outcome[1])
            continue
        comments += outcome[1]
        observations += outcome[2]
        good += [("issue", ident) for ident in outcome[0]]

    conn.execute("BEGIN IMMEDIATE")
    try:
        _write_cycle(conn, by_target, comments, observations, good, t, result)
        conn.execute("COMMIT")
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    return result


def _write_cycle(conn, by_target, comments, observations, good, t, result) -> None:
    own_comments = {r["ref"] for r in conn.execute("SELECT ref FROM own_writes WHERE kind = 'comment'")}
    own_states = {r["ref"]: (r["value"], parse_ts(r["at"]))
                  for r in conn.execute("SELECT ref, value, at FROM own_writes WHERE kind = 'state'")}
    known = {r["identifier"]: (r["state"], parse_ts(r["updated_at"]))
             for r in conn.execute("SELECT identifier, state, updated_at FROM issue_states")}

    def concerned(ident: str, project: str | None) -> list:
        subs = list(by_target.get(("issue", ident), []))
        if project:
            subs += by_target.get(("project", project), [])
        return subs

    def emit(event_id: str, ts: datetime, text: str, subs: list) -> None:
        for sub in subs:
            if ts <= _floor(sub):
                continue
            inserted = conn.execute(
                "INSERT OR IGNORE INTO events (id, session, ts, text) VALUES (?, ?, ?, ?)",
                (event_id, sub["session"], fmt(ts), text),
            ).rowcount
            if inserted:
                result.lines += 1
                result.sessions.add(sub["session"])

    seen: set[str] = set()
    for c in sorted(comments, key=lambda c: (c["created"], c["id"])):
        if c["id"] in seen or c["id"] in own_comments:
            continue
        seen.add(c["id"])
        hhmm = c["created"].astimezone().strftime("%H:%M")  # the machine's local time
        emit(f"comment:{c['id']}", c["created"],
             _line(c["identifier"], f"comment by {c['author']} ({hhmm})", c["url"]),
             concerned(c["identifier"], c["project"]))

    newest: dict[str, dict] = {}
    for obs in observations:
        current = newest.get(obs["identifier"])
        if current is None or obs["updated"] > current["updated"]:
            newest[obs["identifier"]] = obs
    for ident, obs in newest.items():
        prev = known.get(ident)
        if prev and prev[1] and obs["updated"] <= prev[1]:
            continue  # nothing newer than what issue_states holds
        if prev and prev[0] != obs["state"]:
            own = own_states.get(ident)
            mine = (own is not None and own[0] == obs["state"] and own[1] is not None
                    and (prev[1] is None or own[1] >= prev[1] - CURSOR_OVERLAP))
            if not mine:
                emit(f"state:{ident}:{linear_ts(obs['updated'])}", obs["updated"],
                     _line(ident, f"{prev[0]} → {obs['state']}", obs["url"]),
                     concerned(ident, obs["project"]))
        conn.execute(
            "INSERT INTO issue_states (identifier, state, state_type, updated_at) VALUES (?, ?, ?, ?)"
            " ON CONFLICT (identifier) DO UPDATE SET state = excluded.state,"
            " state_type = excluded.state_type, updated_at = excluded.updated_at",
            (ident, obs["state"], obs["state_type"], linear_ts(obs["updated"])),
        )

    conn.executemany(
        "INSERT INTO cursors (kind, target, last_seen) VALUES (?, ?, ?)"
        " ON CONFLICT (kind, target) DO UPDATE SET last_seen = excluded.last_seen",
        [(kind, target, fmt(t)) for kind, target in good],
    )


def cmd_daemon_once(conn: sqlite3.Connection, args) -> int:
    state_dir = Path(conn.execute("PRAGMA database_list").fetchone()["file"]).parent
    result = run_cycle(conn, state_dir)
    for exc in result.errors:
        print(f"lw: {exc}", file=sys.stderr)
    if not result.watched:
        print("lw: nothing watched")
    else:
        print(f"lw: cycle wrote {result.lines} line(s) for {len(result.sessions)} session(s)"
              f" over {result.watched} target(s)"
              + (f", {len(result.errors)} failed query(ies)" if result.errors else ""))
    return 1 if result.errors else 0


def register_poll(sub, common):
    """Add `lw daemon once`; returns the daemon actions so LW-7 can add run/start/stop."""
    p = sub.add_parser("daemon", parents=[common], help="poll Linear (once, for now)")
    actions = p.add_subparsers(dest="daemon_action", required=True)
    once = actions.add_parser(
        "once", parents=[common], help="run one poll cycle",
        description="Turn Linear changes into wake lines. Exit 1 when a query failed.",
    )
    once.set_defaults(func=cmd_daemon_once)
    return actions


# ── end of poll cycle (LW-3) ──────────────────────────────────────────────────


# ── expiry and doctor (LW-5) ──────────────────────────────────────────────────
#   lw expire [--desktop-dir DIR]   close what must not be watched any more
#   lw doctor [--quiet]             ok / warn / FAIL per check; exit 1 on a FAIL
#
# expire_subscriptions(conn, now, desktop_dir) closes open subscriptions, one
# reason each, first match wins:
#   archived      a desktop session file has isArchived: true and its
#                 cliSessionId or priorCliSessionIds carry the session, and no
#                 non-archived file carries it (a resumed session lives on)
#   session-gone  no desktop session file carries the session; skipped when
#                 the folder is missing (CLI-only machine), holds no session
#                 file, or holds one that cannot be read (maybe half-written)
#   issue-done    issue_states.state_type of the issue is completed/canceled
#   project-done  project_states.state_type of the project is completed/canceled
#   ttl           renewed_at older than LW_TTL_DAYS (default 7)
# The two desktop reasons apply only to harness claude-code: other harnesses
# have no desktop file. It then purges delivered events older than 7 days;
# undelivered lines stay, so the last transition of a finished issue is still
# delivered after its subscription closed. LW-7 calls it at the start of each
# cycle; until then `lw expire` runs it by hand.
#
# Desktop files (default DESKTOP_SESSIONS_DEFAULT, else $LW_DESKTOP_DIR) are
# globbed as */*/local_*.json and read for three keys only: cliSessionId,
# priorCliSessionIds, isArchived. Nothing else of them is kept or printed. The
# folder is scanned before the write lock is taken: it holds thousands of files
# and a long lock would starve `lw wait`.
#
# project_states(slug_id, state_type, updated_at) holds the last seen
# status.type of a watched project; the poll fills it with
# record_project_state(). It is created here with IF NOT EXISTS rather than as
# a MIGRATIONS entry so that LW-3, which edits this file in parallel, keeps the
# migration list to itself; fold it into a migration when both have landed.
#
# The heartbeat is <state_dir>/heartbeat; its mtime is the beat (the daemon
# touches it after each cycle, LW-7). doctor fails when it is absent (daemon not
# started) or older than 3 x LW_POLL_SECONDS (default 300). doctor never calls
# Linear: the credential and transport checks read transport.json (LW-2).
import time  # noqa: E402  (also imported by LW-4; kept so this section stands alone)

DESKTOP_SESSIONS_DEFAULT = Path("Library") / "Application Support" / "Claude" / "claude-code-sessions"
DESKTOP_GLOB = "*/*/local_*.json"
DESKTOP_HARNESSES = ("claude-code",)
DONE_STATE_TYPES = ("completed", "canceled")
TTL_DAYS_DEFAULT = 7.0
EVENT_RETENTION = timedelta(days=7)
HEARTBEAT_FILE = "heartbeat"
POLL_SECONDS_DEFAULT = 300.0
HEARTBEAT_INTERVALS = 3


def default_desktop_dir() -> Path:
    env = os.environ.get("LW_DESKTOP_DIR")
    if env:
        return Path(env).expanduser()
    return Path.home() / DESKTOP_SESSIONS_DEFAULT


def _positive_env(name: str, default: float) -> float:
    raw = os.environ.get(name, "")
    if not raw:
        return default
    try:
        value = float(raw)
    except ValueError:
        value = 0.0
    if not value > 0:
        raise LwError(f"{name} must be a positive number, got {raw!r}")
    return value


def ttl_days() -> float:
    return _positive_env("LW_TTL_DAYS", TTL_DAYS_DEFAULT)


def poll_seconds() -> float:
    return _positive_env("LW_POLL_SECONDS", POLL_SECONDS_DEFAULT)


def ensure_expiry_schema(conn: sqlite3.Connection) -> None:
    conn.execute(
        "CREATE TABLE IF NOT EXISTS project_states ("
        " slug_id TEXT PRIMARY KEY, state_type TEXT NOT NULL, updated_at TEXT NOT NULL)"
    )


def record_project_state(conn: sqlite3.Connection, slug_id: str, state_type: str,
                         updated_at: str | None = None) -> None:
    """Upsert a project's status.type (backlog, planned, started, paused, completed, canceled)."""
    ensure_expiry_schema(conn)
    conn.execute(
        "INSERT INTO project_states (slug_id, state_type, updated_at) VALUES (?, ?, ?)"
        " ON CONFLICT (slug_id) DO UPDATE SET"
        " state_type = excluded.state_type, updated_at = excluded.updated_at",
        (slug_id, state_type, updated_at or fmt(now())),
    )


def scan_desktop_sessions(desktop_dir) -> dict | None:
    """{"live", "archived", "complete"} from the desktop session files; None without a folder.

    live: ids carried by a non-archived file; archived: ids carried only by
    archived files; complete: every file was read and there was at least one.
    """
    if not desktop_dir or not Path(desktop_dir).is_dir():
        return None
    live: set[str] = set()
    archived: set[str] = set()
    files = unreadable = 0
    for path in Path(desktop_dir).glob(DESKTOP_GLOB):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            unreadable += 1
            continue
        if not isinstance(data, dict):
            unreadable += 1
            continue
        cli, prior, is_archived = (
            data.get("cliSessionId"), data.get("priorCliSessionIds"), data.get("isArchived")
        )
        del data  # nothing else of the file is kept
        files += 1
        ids = [cli] if isinstance(cli, str) and cli else []
        if isinstance(prior, list):
            ids += [p for p in prior if isinstance(p, str) and p]
        (archived if is_archived is True else live).update(ids)
    return {"live": live, "archived": archived - live, "complete": files > 0 and not unreadable}


def _close_reason(row: sqlite3.Row, scan: dict | None, stale_before: str) -> str | None:
    if scan is not None and row["harness"] in DESKTOP_HARNESSES:
        if row["session"] in scan["archived"]:
            return "archived"
        if scan["complete"] and row["session"] not in scan["live"]:
            return "session-gone"
    if row["kind"] == "issue" and row["issue_type"] in DONE_STATE_TYPES:
        return "issue-done"
    if row["kind"] == "project" and row["project_type"] in DONE_STATE_TYPES:
        return "project-done"
    if row["renewed_at"] < stale_before:
        return "ttl"
    return None


def expire_subscriptions(conn: sqlite3.Connection, now: datetime, desktop_dir) -> dict:
    """Close what must not be watched any more and purge old delivered events.

    Returns {"closed": [{"session", "kind", "target", "reason"}], "purged": n}.
    `now` is the cycle's clock (a datetime); the module-level now() is not used.
    """
    ensure_expiry_schema(conn)
    stale_before = fmt(now - timedelta(days=ttl_days()))
    purge_before = fmt(now - EVENT_RETENTION)
    at = fmt(now)
    scan = scan_desktop_sessions(desktop_dir)
    closed: list[dict] = []
    conn.execute("BEGIN IMMEDIATE")
    try:
        rows = conn.execute(
            "SELECT s.id, s.session, s.harness, s.kind, s.target, s.renewed_at,"
            " i.state_type AS issue_type, p.state_type AS project_type"
            " FROM subscriptions s"
            " LEFT JOIN issue_states i ON s.kind = 'issue' AND i.identifier = s.target"
            " LEFT JOIN project_states p ON s.kind = 'project' AND p.slug_id = s.target"
            " WHERE s.closed_at IS NULL ORDER BY s.session, s.kind, s.target, s.id"
        ).fetchall()
        for row in rows:
            reason = _close_reason(row, scan, stale_before)
            if reason is None:
                continue
            conn.execute(
                "UPDATE subscriptions SET closed_at = ?, close_reason = ?"
                " WHERE id = ? AND closed_at IS NULL",
                (at, reason, row["id"]),
            )
            closed.append({"session": row["session"], "kind": row["kind"],
                           "target": row["target"], "reason": reason})
        purged = conn.execute(
            "DELETE FROM events WHERE delivered_at IS NOT NULL AND delivered_at < ?",
            (purge_before,),
        ).rowcount
        conn.execute("COMMIT")
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    return {"closed": closed, "purged": purged}


def cmd_expire(conn: sqlite3.Connection, args) -> int:
    result = expire_subscriptions(conn, now(), args.desktop_dir or default_desktop_dir())
    for c in result["closed"]:
        print(f"closed {c['session']} {c['kind']} {c['target']}: {c['reason']}")
    if result["purged"]:
        print(f"purged {result['purged']} delivered event(s) older than {EVENT_RETENTION.days} days")
    if not result["closed"] and not result["purged"]:
        print("nothing expired")
    return 0


def register_expiry(sub, common) -> None:
    p = sub.add_parser(
        "expire", parents=[common], help="close finished or abandoned subscriptions now",
        description="Close subscriptions of archived or gone sessions, of finished"
        " issues and projects, and those not renewed for LW_TTL_DAYS; purge delivered"
        " events older than 7 days.",
    )
    p.add_argument(
        "--desktop-dir", type=Path, metavar="DIR",
        help="Claude desktop sessions folder (default: $LW_DESKTOP_DIR or"
        f" ~/{DESKTOP_SESSIONS_DEFAULT})",
    )
    p.set_defaults(func=cmd_expire)


def heartbeat_age(state_dir: Path) -> float | None:
    """Seconds since the daemon's last beat; None when it never beat."""
    try:
        return max(0.0, time.time() - (Path(state_dir) / HEARTBEAT_FILE).stat().st_mtime)
    except OSError:
        return None


def _age(seconds: float) -> str:
    s = int(max(0, seconds))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    if m:
        return f"{m}m"
    return f"{s}s"


def _parse_ts(value: str) -> datetime:
    return datetime.strptime(value, TS_FORMAT).replace(tzinfo=timezone.utc)


def doctor_checks(conn: sqlite3.Connection, state_dir: Path) -> list[tuple[str, str]]:
    checks: list[tuple[str, str]] = []

    binary = linear_bin()
    if binary and os.path.isfile(binary) and os.access(binary, os.X_OK):
        checks.append(("ok", f"linear binary {binary}"))
    elif os.environ.get("LW_LINEAR_BIN"):
        checks.append(("FAIL", f"linear binary not found at {binary} (LW_LINEAR_BIN)"))
    else:
        checks.append(("FAIL", "linear binary not found: brew install schpet/tap/linear,"
                               f" or set LW_LINEAR_BIN (default {LINEAR_DEFAULT_BIN})"))

    status = read_transport_status(state_dir)
    last_ok = status.get("last_ok") if isinstance(status.get("last_ok"), str) else None
    err = status.get("last_error") if isinstance(status.get("last_error"), dict) else None
    err_at = str(err.get("at", "")) if err else ""
    current = bool(err) and (last_ok is None or err_at >= last_ok)
    code = err.get("code") if err else None

    if not load_linear_key():
        checks.append(("FAIL", "credential missing: no LINEAR_API_KEY in the environment"
                               " nor in ~/.config/linear/env"))
    elif current and code == T_CREDENTIAL:
        checks.append(("FAIL", f"credential rejected by Linear at {err_at}: fix LINEAR_API_KEY"
                               " in ~/.config/linear/env"))
    else:
        source = "environment" if os.environ.get("LINEAR_API_KEY") else "~/.config/linear/env"
        checks.append(("ok", f"credential present ({source})"))

    try:
        limit = HEARTBEAT_INTERVALS * poll_seconds()
    except LwError as exc:
        checks.append(("FAIL", f"heartbeat limit unknown: {exc}"))
    else:
        age = heartbeat_age(state_dir)
        if age is None:
            checks.append(("FAIL", "heartbeat absent: daemon not started"))
        elif age > limit:
            checks.append(("FAIL", f"heartbeat stale: {_age(age)} old"
                                   f" (limit {_age(limit)} = {HEARTBEAT_INTERVALS} x LW_POLL_SECONDS)"))
        else:
            checks.append(("ok", f"heartbeat {_age(age)} old"))

    if current:
        level = "warn" if code == T_RATE_LIMITED else "FAIL"
        checks.append((level, f"last Linear call failed at {err_at}: {err.get('query')}:"
                              f" {err.get('message')} (code {code})"))
    elif err:
        checks.append(("ok", f"last Linear call ok at {last_ok}"
                             f" (recovered from code {code} at {err_at})"))
    elif last_ok:
        checks.append(("ok", f"last Linear call ok at {last_ok}"))
    else:
        checks.append(("ok", "no Linear call recorded yet"))

    t = now()
    sessions: dict[str, list[sqlite3.Row]] = {}
    for row in conn.execute(
        "SELECT session, kind, target, created_at, renewed_at FROM subscriptions"
        " WHERE closed_at IS NULL ORDER BY session, kind, target"
    ):
        sessions.setdefault(row["session"], []).append(row)
    for session, rows in sessions.items():
        oldest = min(_parse_ts(r["created_at"]) for r in rows)
        renewed = max(_parse_ts(r["renewed_at"]) for r in rows)
        targets = ", ".join(f"{r['kind']} {r['target']}" for r in rows)
        checks.append(("ok", f"session {session}: {len(rows)} open ({targets}),"
                             f" oldest {_age((t - oldest).total_seconds())},"
                             f" renewed {_age((t - renewed).total_seconds())} ago"))
    if not sessions:
        checks.append(("ok", "no open subscription"))
    return checks


def cmd_doctor(conn: sqlite3.Connection, args) -> int:
    state_dir = Path(conn.execute("PRAGMA database_list").fetchone()["file"]).parent
    checks = doctor_checks(conn, state_dir)
    if not args.quiet:
        for level, text in checks:
            print(f"{level} {text}")
    return 1 if any(level == "FAIL" for level, _ in checks) else 0


def register_doctor(sub, common) -> None:
    p = sub.add_parser(
        "doctor", parents=[common], help="check binary, credential, heartbeat, transport",
        description="One ok/warn/FAIL line per check; exit 1 when any check fails."
        " Never calls Linear.",
    )
    p.add_argument("--quiet", action="store_true", help="print nothing; the exit code says it")
    p.set_defaults(func=cmd_doctor)


# ── end of expiry and doctor (LW-5) ───────────────────────────────────────────


# ── daemon (LW-7) ─────────────────────────────────────────────────────────────
#   lw daemon run [--cycles N]   the loop: every LW_POLL_SECONDS (300), expire then poll
#   lw daemon start              install and load ~/Library/LaunchAgents/com.linear-watch.daemon.plist
#   lw daemon stop               unload it and remove the plist
#   lw daemon alive              exit 0 when the heartbeat is younger than 3 intervals
#
# One cycle: beat, then on a fresh connection expire_subscriptions() (LW-5)
# followed by run_cycle() (LW-3), beat again, and write one line to
# <state_dir>/daemon.log (counts and failed query names only: no comment text,
# no secret). Any Exception in a cycle is logged as `cycle failed: …` and the
# loop goes on; a bad LW_POLL_SECONDS refuses to start instead (exit 2).
# The log rolls over to daemon.log.1 past DAEMON_LOG_MAX bytes.
#
# Re-exec (lesson from pr-watch §9: a long-running process never reloads its
# code): at start the daemon writes <state_dir>/daemon.started holding the
# mtime of the script it runs. After each sleep, when the script's mtime
# differs from it (newer after an install, or older after a `cp -p` of an
# older copy), it os.execv()s the same interpreter on the same script with the
# same --state-dir; the new process rewrites the marker. --cycles is not
# carried over (launchd never passes it).
#
# `start` refuses to run from a git checkout or a worktree (a .git directory or
# file above the script, or a `worktrees` component in its path): the plist
# would keep pointing at a checkout that moves or disappears. LW_ALLOW_CHECKOUT=1
# overrides it (tests). The plist gets absolute paths only: the interpreter
# running `start`, the script, the state dir, and the linear binary as resolved
# now (LW_LINEAR_BIN: launchd's PATH lacks /opt/homebrew/bin). No secret goes
# into it: the transport reads ~/.config/linear/env itself.
#
# Exit codes: run 0 after --cycles, 2 bad configuration · start 0 loaded,
# 1 launchctl failed, 2 refused (checkout, no launchctl, no linear binary) ·
# stop 0 · alive 0 alive, 1 not alive (one line on stdout either way).
import signal  # noqa: E402
from xml.sax.saxutils import escape as xml_escape  # noqa: E402

LW_SCRIPT = os.path.abspath(__file__)
LAUNCHD_LABEL = "com.linear-watch.daemon"
DAEMON_TEMPLATE = Path(__file__).resolve().parent.parent / "templates" / f"{LAUNCHD_LABEL}.plist"
DAEMON_LOG = "daemon.log"
DAEMON_LOG_MAX = 1_000_000  # bytes
DAEMON_LOG_LINE_MAX = 500
DAEMON_STARTED = "daemon.started"
LAUNCHCTL_RETRY_SECONDS = 1.0  # bootout is asynchronous: one retry of bootstrap


def _daemon_state_dir(args) -> Path:
    return Path(getattr(args, "state_dir", None) or default_state_dir()).expanduser().absolute()


def _write_private(path: Path, text: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)


def daemon_log(state_dir: Path, text: str) -> None:
    """Append one timestamped line to daemon.log; never fails the daemon."""
    try:
        state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = state_dir / DAEMON_LOG
        try:
            if path.stat().st_size > DAEMON_LOG_MAX:
                os.replace(path, state_dir / f"{DAEMON_LOG}.1")
        except OSError:
            pass
        line = " ".join(f"{fmt(now())} {text}".split())[:DAEMON_LOG_LINE_MAX]
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def daemon_beat(state_dir: Path) -> None:
    """Rewrite the heartbeat file: its mtime is what doctor and alive read."""
    try:
        state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        _write_private(state_dir / HEARTBEAT_FILE, f"{int(time.time())}\n")
    except OSError:
        pass


def _cycle_summary(expired: dict, result: CycleResult) -> str:
    parts = []
    if expired["closed"]:
        reasons: dict[str, int] = {}
        for c in expired["closed"]:
            reasons[c["reason"]] = reasons.get(c["reason"], 0) + 1
        detail = ", ".join(f"{r} {n}" for r, n in sorted(reasons.items()))
        parts.append(f"expired {len(expired['closed'])} ({detail})")
    if expired["purged"]:
        parts.append(f"purged {expired['purged']} event(s)")
    if not result.watched:
        parts.append("nothing watched")
    else:
        parts.append(f"wrote {result.lines} line(s) for {len(result.sessions)} session(s)"
                     f" over {result.watched} target(s)")
    if result.errors:
        seen = list(dict.fromkeys(f"{e.query}: {e.message} (code {e.code})" for e in result.errors))
        parts.append(f"{len(result.errors)} failed query(ies): " + "; ".join(seen))
    return "cycle " + ", ".join(parts)


def daemon_cycle(state_dir: Path, desktop_dir) -> str:
    """Expire then poll once; returns the log text. Never raises an Exception."""
    daemon_beat(state_dir)
    try:
        conn = connect(state_dir)
        try:
            expired = expire_subscriptions(conn, now(), desktop_dir)
            result = run_cycle(conn, state_dir)
        finally:
            conn.close()
    except Exception as exc:  # noqa: BLE001 — a failing cycle never kills the loop
        text = f"cycle failed: {type(exc).__name__}: {exc}"
    else:
        text = _cycle_summary(expired, result)
    daemon_beat(state_dir)
    return text


def _script_mtime() -> int | None:
    try:
        return os.stat(LW_SCRIPT).st_mtime_ns
    except OSError:
        return None


def write_start_marker(state_dir: Path) -> None:
    _write_private(state_dir / DAEMON_STARTED, f"{_script_mtime() or 0}\n")


def script_changed(state_dir: Path) -> bool:
    """The script on disk is not the one this process loaded."""
    current = _script_mtime()
    if current is None:
        return False  # being replaced right now: look again next cycle
    try:
        recorded = int((state_dir / DAEMON_STARTED).read_text().strip())
    except (OSError, ValueError):
        return False
    return current != recorded


def daemon_run(state_dir: Path, cycles: int | None = None, sleep=time.sleep,
               desktop_dir=None) -> int:
    interval = poll_seconds()  # LwError on a bad value: refuse to start
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    write_start_marker(state_dir)
    desktop_dir = desktop_dir or default_desktop_dir()
    daemon_log(state_dir, f"daemon started (pid {os.getpid()}, every {interval:g} s, {LW_SCRIPT})")
    done = 0
    while True:
        daemon_log(state_dir, daemon_cycle(state_dir, desktop_dir))
        done += 1
        if cycles is not None and done >= cycles:
            return 0
        sleep(interval)
        if script_changed(state_dir):
            daemon_log(state_dir, f"script changed on disk ({LW_SCRIPT}): re-exec (pid {os.getpid()})")
            argv = [sys.executable, LW_SCRIPT, "daemon", "run", "--state-dir", str(state_dir)]
            os.execv(sys.executable, argv)


def _on_term(signum, _frame):
    raise SystemExit(0)


def cmd_daemon_run(conn: sqlite3.Connection, args) -> int:
    if args.cycles is not None and args.cycles < 1:
        raise LwError(f"--cycles must be 1 or more, got {args.cycles}")
    state_dir = _daemon_state_dir(args)
    conn.close()  # each cycle opens its own connection
    previous = signal.signal(signal.SIGTERM, _on_term)  # launchd stops with TERM
    try:
        return daemon_run(state_dir, cycles=args.cycles)
    except SystemExit:
        daemon_log(state_dir, f"daemon stopped by signal (pid {os.getpid()})")
        raise
    finally:
        signal.signal(signal.SIGTERM, previous)


def cmd_daemon_alive(conn: sqlite3.Connection, args) -> int:
    limit = HEARTBEAT_INTERVALS * poll_seconds()
    age = heartbeat_age(_daemon_state_dir(args))
    if age is None:
        print("not alive: no heartbeat, the daemon never ran")
        return 1
    if age > limit:
        print(f"not alive: heartbeat {_age(age)} old (limit {_age(limit)})")
        return 1
    print(f"alive: heartbeat {_age(age)} old")
    return 0


def in_checkout(script: str) -> bool:
    """The script lives in a git checkout or a worktree, not in an installed copy."""
    path = Path(script).absolute()
    if "worktrees" in path.parts:
        return True
    return any((parent / ".git").exists() for parent in path.parents)


def plist_path() -> Path:
    return Path.home() / "Library" / "LaunchAgents" / f"{LAUNCHD_LABEL}.plist"


def render_plist(values: dict[str, str]) -> str:
    text = DAEMON_TEMPLATE.read_text(encoding="utf-8")
    for key, value in values.items():
        text = text.replace(f"@{key}@", xml_escape(value))
    return text


def _launchctl() -> str:
    binary = shutil.which("launchctl")
    if not binary:
        raise LwError("launchd not available (no launchctl on PATH):"
                      " run `nohup lw daemon run >/dev/null 2>&1 &` instead")
    return binary


def cmd_daemon_start(conn: sqlite3.Connection, args) -> int:
    script = LW_SCRIPT
    if os.environ.get("LW_ALLOW_CHECKOUT") != "1" and in_checkout(script):
        raise LwError(
            f"refusing: lw runs from a git checkout or worktree ({script}); the launchd"
            " plist would keep pointing at it after it moves or disappears.\n"
            "  Install the skill first (bash install.sh, from the repository) and run the"
            " installed copy: ~/.agents/skills/linear-watch/scripts/lw daemon start"
        )
    launchctl = _launchctl()
    binary = linear_bin()
    if not binary or not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        raise LwError(f"linear binary not found ({binary or 'nothing on PATH'}):"
                      " brew install schpet/tap/linear, or set LW_LINEAR_BIN")
    if not sys.executable:
        raise LwError("cannot tell which python runs lw (sys.executable is empty)")
    state_dir = _daemon_state_dir(args)
    plist = plist_path()
    text = render_plist({
        "PYTHON": sys.executable,
        "LW": script,
        "STATE": str(state_dir),
        "HOME": str(Path.home()),
        "LINEAR_BIN": os.path.abspath(binary),  # the PATH entry, never its realpath
    })
    plist.parent.mkdir(parents=True, exist_ok=True)
    tmp = plist.with_name(f".{plist.name}.{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    tmp.chmod(0o644)
    os.replace(tmp, plist)

    domain = f"gui/{os.getuid()}"
    subprocess.run([launchctl, "bootout", f"{domain}/{LAUNCHD_LABEL}"], capture_output=True)
    for attempt in range(2):
        proc = subprocess.run([launchctl, "bootstrap", domain, str(plist)],
                              capture_output=True, text=True)
        if proc.returncode == 0:
            print(f"daemon started ({plist})")
            return 0
        if attempt == 0:
            time.sleep(LAUNCHCTL_RETRY_SECONDS)
    detail = (proc.stderr or proc.stdout).strip().splitlines()
    print(f"lw: launchctl bootstrap failed (exit {proc.returncode})"
          + (f": {detail[0]}" if detail else ""), file=sys.stderr)
    return 1


def cmd_daemon_stop(conn: sqlite3.Connection, args) -> int:
    launchctl = _launchctl()
    proc = subprocess.run([launchctl, "bootout", f"gui/{os.getuid()}/{LAUNCHD_LABEL}"],
                          capture_output=True, text=True)
    try:
        plist_path().unlink()
    except FileNotFoundError:
        pass
    print("daemon stopped" if proc.returncode == 0 else "daemon was not loaded")
    return 0


def register_daemon(actions, common) -> None:
    """Add run/start/stop/alive to the `daemon` actions register_poll() returned."""
    p = actions.add_parser(
        "run", parents=[common], help="poll every LW_POLL_SECONDS (what launchd runs)",
        description="Loop: expire subscriptions, poll Linear, beat the heartbeat, log one"
        " line to daemon.log; re-exec when the script changes on disk.",
    )
    p.add_argument("--cycles", type=int, metavar="N",
                   help="stop after N cycles (tests, a manual check)")
    p.set_defaults(func=cmd_daemon_run)
    p = actions.add_parser(
        "start", parents=[common], help=f"install and load the launchd agent {LAUNCHD_LABEL}",
        description="Refused from a git checkout or worktree (LW_ALLOW_CHECKOUT=1 overrides)."
        " Exit 1 when launchctl fails, 2 when refused.",
    )
    p.set_defaults(func=cmd_daemon_start)
    p = actions.add_parser("stop", parents=[common], help="unload the launchd agent, remove its plist")
    p.set_defaults(func=cmd_daemon_stop)
    p = actions.add_parser(
        "alive", parents=[common], help="exit 0 when the heartbeat is younger than 3 intervals",
    )
    p.set_defaults(func=cmd_daemon_alive)


# ── end of daemon (LW-7) ──────────────────────────────────────────────────────


# ── CLI ───────────────────────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--state-dir", type=Path, default=argparse.SUPPRESS,
        help="state directory (default: $LW_STATE_DIR or ~/.local/state/linear-watch)",
    )
    parser = argparse.ArgumentParser(
        prog="lw", parents=[common], description=__doc__.split("\n\n")[0]
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("subscribe", parents=[common], help="watch a project or an issue")
    p.add_argument("--session", required=True)
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--project", metavar="SLUG|URL")
    target.add_argument("--issue", metavar="TT-123")
    p.add_argument("--since", metavar="3d", help="also deliver changes since then (max 7d)")
    p.add_argument("--harness", default=DEFAULT_HARNESS)
    p.set_defaults(func=cmd_subscribe)

    p = sub.add_parser("unsubscribe", parents=[common], help="stop watching")
    p.add_argument("--session", required=True)
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("--project", metavar="SLUG|URL")
    target.add_argument("--issue", metavar="TT-123")
    target.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_unsubscribe)

    p = sub.add_parser("list", parents=[common], help="show subscriptions")
    p.add_argument("--session")
    p.add_argument("--closed", action="store_true", help="include closed subscriptions")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    register_wait(sub, common)
    add_own_write_parser(sub, common)
    register_expiry(sub, common)
    register_doctor(sub, common)
    daemon_actions = register_poll(sub, common)
    register_daemon(daemon_actions, common)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    state_dir = getattr(args, "state_dir", None) or default_state_dir()
    try:
        if args.command in ("subscribe", "unsubscribe") and not getattr(args, "all", False):
            target_of(args)  # validate before touching the store
        conn = connect(state_dir)
        try:
            return args.func(conn, args)
        finally:
            conn.close()
    except LwError as exc:
        print(f"lw: {exc}", file=sys.stderr)
        return 2
    except sqlite3.Error as exc:
        print(f"lw: store error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
