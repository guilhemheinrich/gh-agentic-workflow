# tests/env/.env.prod — target: production. READ-ONLY SMOKE ONLY.
#
# COMMITTED. URLs only. No account, no password, no DATABASE_URL.
#
# Two locks apply before a single request leaves the runner:
#   1. with-env.sh refuses TEST_ENV=prod unless PROD_CONFIRM=1 is on the
#      command line of THAT run (never in a file, never in a shell profile).
#   2. Only tests carrying the @prod-safe tag (or TestProdSafe_* in Go) run;
#      the Makefile adds the filter and the fixture enforces it per test.
#
# List before you run:  make test-e2e-list ENV=prod PROD_CONFIRM=1

TEST_ENV=prod
E2E_BASE_URL=https://app.example.com
API_BASE_URL=https://api.example.com
