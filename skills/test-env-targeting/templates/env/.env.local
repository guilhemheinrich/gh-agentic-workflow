# tests/env/.env.local — target: the compose stack running on this machine.
#
# COMMITTED. Non-secret values only: URLs, ports, demo account *names*.
# Secrets go to .env.local.secret (gitignored, see gitignore.snippet).
#
# Format: KEY=VALUE, one per line, double quotes when the value has spaces.
# The file is sourced by bash (with-env.sh), read by Node (--env-file /
# process.loadEnvFile) and by the Go loader — keep it to that common subset:
# no `export`, no spaces around `=`, no multi-line values.
#
# URLs are written as seen FROM THE RUNNER. These defaults assume the runner
# is a process on the host. A runner inside a compose service overrides them
# with service hostnames in its `environment:` block (the shell always wins).

TEST_ENV=local
E2E_BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8080

# Backing services — local only. Integration tests refuse to run without it.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app_test?sslmode=disable

# Demo identity seeded by the local stack. Its password is a known demo
# value, yet it lives in .env.local.secret like every other password, so the
# rule "passwords are never in a committed file" has no exception to learn.
TEST_USER_EMAIL=demo@example.test
