# tests/env/.env.staging — target: the shared staging (pprod) deployment.
#
# COMMITTED. URLs and demo account names only. TEST_USER_PASSWORD lives in
# .env.staging.secret (gitignored), or is exported by the CI secret store.
#
# No DATABASE_URL on purpose: integration tests do not target a remote
# database. A remote "live" lane is an explicit opt-in (TEST_LIVE=1) and
# reads its own variables.

TEST_ENV=staging
E2E_BASE_URL=https://app.staging.example.com
API_BASE_URL=https://api.staging.example.com

TEST_USER_EMAIL=e2e-demo@staging.example.test
