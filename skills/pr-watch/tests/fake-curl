#!/usr/bin/env bash
# fake-curl — stands in for curl in the prw tests. Serves fixture files from
# $FAKE_CURL_DIR and logs every requested URL to $FAKE_CURL_LOG.
#
# Understands the options prw uses: -o FILE, -D FILE, -w '%{http_code}', -K -.
# The -K config arrives on stdin; it is read and discarded, never logged, so a
# test can grep the log for the token and prove it never left the process.
set -u
out="" hdr="" write="" url="" follow=0 cfg=""
while [ $# -gt 0 ]; do
  case "$1" in
    -L) follow=1 ;;
    -o) out="$2"; shift ;;
    -D) hdr="$2"; shift ;;
    -w) write="$2"; shift ;;
    -K) [ "$2" = "-" ] && cfg="$(cat)"; shift ;;
    --max-time|-H|-u) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done
printf '%s\n' "$url" >>"${FAKE_CURL_LOG:-/dev/null}"
tail="${url#"$BITBUCKET_API_BASE"/}"
case "$tail" in "$url") tail="${url#"$GITHUB_API_BASE"/}" ;; esac
key="$(printf '%s' "$tail" | LC_ALL=C sed 's/[^A-Za-z0-9._-]/_/g')"
# A <key>.location file makes the response a 302 to that URL tail; with -L
# the fake follows it, like curl does.
if [ -f "$FAKE_CURL_DIR/$key.location" ]; then
  if [ "$follow" = 1 ]; then
    tail="$(cat "$FAKE_CURL_DIR/$key.location")"
    printf '%s\n' "$BITBUCKET_API_BASE/$tail" >>"${FAKE_CURL_LOG:-/dev/null}"
    key="$(printf '%s' "$tail" | LC_ALL=C sed 's/[^A-Za-z0-9._-]/_/g')"
  else
    [ -n "$out" ] && : >"$out"
    [ -n "$hdr" ] && : >"$hdr"
    [ "$write" = '%{http_code}' ] && printf 302
    exit 0
  fi
fi
# Per-token behaviour, from $FAKE_CURL_DIR/tokens/<token>.<rule> (the token is
# read from the config on stdin and goes only to the separate auth log):
#   .invalid      every request answers 401
#   .ratelimited  every request answers 403 with x-ratelimit-remaining: 0
#   .repos        one OWNER/REPO per line: the only repositories it reads (404
#                 elsewhere); without the file, a token reads everything (a
#                 classic `repo` token)
#   .classic      answers carry an X-OAuth-Scopes header
token="$(printf '%s\n' "$cfg" | sed -n 's/^header = "Authorization: Bearer \(.*\)"$/\1/p' | head -1)"
tdir="$FAKE_CURL_DIR/tokens"
[ -n "${FAKE_CURL_AUTHLOG:-}" ] && printf '%s %s\n' "$token" "$tail" >>"$FAKE_CURL_AUTHLOG"
extra=""
if [ -n "$token" ] && [ -d "$tdir" ]; then
  [ -f "$tdir/$token.classic" ] && extra="X-OAuth-Scopes: repo"
  tcode=""
  if [ -f "$tdir/$token.invalid" ]; then tcode=401
  elif [ -f "$tdir/$token.ratelimited" ]; then tcode=403; extra="x-ratelimit-remaining: 0"
  elif [ -f "$tdir/$token.repos" ]; then
    case "$tail" in
      repos/*/*)
        r="${tail#repos/}"; r="${r%%/*}/$(printf '%s' "${tail#repos/*/}" | sed 's#[/?].*##')"
        grep -qxF "$r" "$tdir/$token.repos" || tcode=404 ;;
    esac
  fi
  if [ -n "$tcode" ]; then
    [ -n "$out" ] && printf '{}' >"$out"
    [ -n "$hdr" ] && printf '%s\n' "$extra" >"$hdr"
    [ "$write" = '%{http_code}' ] && printf '%s' "$tcode"
    exit 0
  fi
fi
body="$FAKE_CURL_DIR/$key.json"
code=200
if [ -f "$FAKE_CURL_DIR/$key.code" ]; then code="$(cat "$FAKE_CURL_DIR/$key.code")"
elif [ ! -f "$body" ]; then code=404; fi
if [ -n "$out" ]; then
  if [ -f "$body" ]; then cat "$body" >"$out"; else printf '{}' >"$out"; fi
fi
if [ -n "$hdr" ]; then
  if [ -f "$FAKE_CURL_DIR/$key.headers" ]; then cat "$FAKE_CURL_DIR/$key.headers" >"$hdr"; else : >"$hdr"; fi
  [ -n "$extra" ] && printf '%s\n' "$extra" >>"$hdr"
fi
[ "$write" = '%{http_code}' ] && printf '%s' "$code"
exit 0
