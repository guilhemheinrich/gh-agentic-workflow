#!/usr/bin/env bash
# pr-relay — deliver pr-watch wake lines to Claude Desktop sessions whose own
# `prw wait` / `bbw wait` is not armed, and subscribe the user's open PRs that
# no session subscribed to.
#
# Deterministic half of the CCD relay. It never talks to a session itself: it
# prints what to deliver, and the relay session (an LLM turn woken by
# `pr-relay wait` exiting) sends each message with the CCD session tools, then
# acks. Read-only on Bitbucket; writes only the watcher's cursors and, through
# the watcher's own CLI, its subscriptions. bash 3.2 compatible.
set -uo pipefail

usage() {
  cat <<'EOF'
pr-relay — relay pr-watch news to Claude Desktop sessions that stopped listening.

  pr-relay scan                 JSON: deliveries (sessions with unread lines and no live wait) and undeliverable ones
  pr-relay ack CLI_SESSION N    advance that session's cursor by N lines (exit 4: its own wait is live, send nothing)
  pr-relay park CLI_SESSION     skip that session until a new line arrives (after a send that failed)
  pr-relay discover [--subscribe]
                                JSON: your open PRs no subscription covers, with the session that owns each branch;
                                --subscribe subscribes each to its owner, or to the relay inbox when it has none
  pr-relay sweep                one pass over your open (and recently merged) PRs, no subscription needed;
                                JSON: one message per session about what changed since the last sweep
  pr-relay wait [--interval S]  every S seconds (default 300): discover --subscribe, then scan;
                                exit 0 printing the scan as soon as something is deliverable
EOF
}

API="${PR_RELAY_API_BASE:-https://api.bitbucket.org/2.0}"
# Same OS rule as the watcher's other scripts: see scripts/lib/desktop.sh.
# Follow symlinks (bash 3.2 has no `readlink -f`): lib/ lives next to the real file.
_self="$0"
while [ -L "$_self" ]; do
  _link="$(readlink "$_self")"
  case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
# shellcheck disable=SC1091
. "$(cd "$(dirname "$_self")/../../scripts/lib" && pwd)/desktop.sh"
_default_sessions_dir="$(claude_desktop_dir)/claude-code-sessions"
SESSIONS_DIR="${PR_RELAY_SESSIONS_DIR:-$_default_sessions_dir}"
RELAY_STATE="${PR_RELAY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pr-relay}"
ORPHAN_TTL="${PR_RELAY_ORPHAN_TTL:-3600}"
RELAY_INBOX="${PR_RELAY_INBOX:-pr-relay-inbox}"

# watch_state — the watcher's state dir: the generic pr-watch one once it holds
# subscriptions, else the legacy bitbucket-pr-watch one.
watch_state() {
  local base="${XDG_STATE_HOME:-$HOME/.local/state}"
  if [ -n "${PR_RELAY_WATCH_STATE:-}" ]; then printf '%s\n' "$PR_RELAY_WATCH_STATE"
  elif [ -f "$base/pr-watch/subscriptions.json" ]; then printf '%s\n' "$base/pr-watch"
  else printf '%s\n' "$base/bitbucket-pr-watch"; fi
}

# watch_cli — the CLI that owns that state dir.
watch_cli() {
  if [ -n "${PR_RELAY_WATCH_CLI:-}" ]; then printf '%s\n' "$PR_RELAY_WATCH_CLI"
  else case "$(watch_state)" in */pr-watch) echo prw ;; *) echo bbw ;; esac; fi
}

load_credential() {
  [ -n "${BITBUCKET_WATCH_TOKEN:-}" ] && return 0
  local f
  for f in "$HOME/.config/pr-watch/env" "$HOME/.config/bitbucket-pr-watch/env"; do
    # shellcheck disable=SC1090
    [ -f "$f" ] && . "$f" && [ -n "${BITBUCKET_WATCH_TOKEN:-}" ] && return 0
  done
  echo "pr-relay: no BITBUCKET_WATCH_TOKEN (run prw setup)" >&2
  return 1
}

bb_get() {
  printf 'user = "%s:%s"\n' "$BITBUCKET_WATCH_USER" "$BITBUCKET_WATCH_TOKEN" \
    | curl -sS -fL --max-time 30 -K - "$@"
}

safe_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# wait_alive CLI — true when a watcher `wait` for that session runs right now.
wait_alive() {
  local pid
  pid="$(cat "$(watch_state)/waits/$(safe_name "$1").lock/pid" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# is_archived LOCAL — the app records archiving in the session file and in an
# index next to it; either counts.
is_archived() {
  find "$SESSIONS_DIR" -maxdepth 3 -name archived-sessions.idx -print0 2>/dev/null \
    | xargs -0 grep -qF "\"$1\"" 2>/dev/null
}

# session_files_with TEXT — the desktop session files that mention TEXT.
# Only files touched in the last PR_RELAY_SESSION_DAYS days are read: the
# folder holds thousands of sessions, most long finished, and reading them all
# takes seconds per lookup.
session_files_with() {
  find "$SESSIONS_DIR" -maxdepth 3 -name 'local_*.json' -mtime "-${PR_RELAY_SESSION_DAYS:-30}" -print0 2>/dev/null \
    | xargs -0 grep -lF -e "$1" 2>/dev/null
}

# ccd_session CLI — JSON {local, title, archived, last} of the desktop session
# that runs (or ran, before a resume) that Claude Code session, or nothing.
ccd_session() {
  local f info
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    info="$(jq -c --arg c "$1" 'select(.cliSessionId == $c or ((.priorCliSessionIds // []) | index($c)))
      | {local: .sessionId, title: (.title // ""), archived: (.isArchived // false), last: (.lastActivityAt // 0)}' "$f" 2>/dev/null)"
    [ -n "$info" ] && break
  done <<EOF
$(session_files_with "$1")
EOF
  [ -n "$info" ] || return 0
  if is_archived "$(jq -r .local <<<"$info")"; then info="$(jq -c '.archived = true' <<<"$info")"; fi
  printf '%s\n' "$info"
}

unread_count() {
  local st="$1" s="$2" f c n=0 total
  f="$st/events/$(safe_name "$s").jsonl"; c="$st/events/$(safe_name "$s").cursor"
  [ -f "$f" ] || { echo 0; return; }
  [ -f "$c" ] && n="$(cat "$c")"
  total="$(wc -l <"$f" | tr -d ' ')"
  echo $(( total > n ? total - n : 0 ))
}

cmd_scan() {
  local st f s n info lines out='[]'
  st="$(watch_state)"
  for f in "$st"/events/*.jsonl; do
    [ -f "$f" ] || continue
    s="$(basename "$f" .jsonl)"
    n="$(unread_count "$st" "$s")"
    [ "$n" -gt 0 ] || continue
    wait_alive "$s" && continue
    # A parked session is skipped until a new line arrives for it.
    [ "$(cat "$RELAY_STATE/parked/$(safe_name "$s")" 2>/dev/null)" = "$(wc -l <"$f" | tr -d ' ')" ] && continue
    if [ "$s" = "$(safe_name "$RELAY_INBOX")" ]; then info='{"local":"relay","title":"","archived":false}'
    else info="$(ccd_session "$s")"; fi
    [ -n "$info" ] || info='{"local":null,"title":"","archived":false}'
    lines="$(tail -n "$n" "$f" | jq -sc '[.[].text]')"
    out="$(jq -c --arg cli "$s" --argjson n "$n" --argjson info "$info" --argjson lines "$lines" \
      '. + [$info + {cli: $cli, count: $n, lines: $lines}]' <<<"$out")"
  done
  jq --arg cli "$(watch_cli)" '
    def message:
      "pr-relay : ton `\($cli) wait` n’est plus armé, voici les nouvelles de ta PR que tu as manquées :\n"
      + (.lines | map("- " + .) | join("\n"))
      + "\n\nSi tu suis encore quelque chose (PR ouverte ou pipeline post-merge), relance `\($cli) wait --session \(.cli)` avec run_in_background.";
    {
      deliveries: [.[] | select(.local != null and .local != "relay" and (.archived | not)) | . + {message: message}],
      relay: [.[] | select(.local == "relay") | {cli, count, lines}],
      undeliverable: [.[] | select(.local == null or .archived) | {cli, count, archived, reason: (if .local == null then "no desktop session" else "archived" end)}]
    }' <<<"$out"
}

cmd_ack() {
  local st s="${1:-}" n="${2:-}" c cur=0 lock
  case "$n" in ''|*[!0-9-]*) echo "usage: pr-relay ack CLI_SESSION N" >&2; return 64 ;; esac
  st="$(watch_state)"
  # Take the watcher's own wait lock while moving the cursor, so a `wait`
  # re-armed at this instant exits "already waiting" instead of reading the
  # same lines.
  lock="$st/waits/$(safe_name "$s").lock"
  mkdir -p "$st/waits"
  if ! mkdir "$lock" 2>/dev/null; then
    if wait_alive "$s"; then echo "pr-relay: a wait is live for $s, it delivers itself" >&2; return 4; fi
    rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 4
  fi
  printf '%s\n' "$$" >"$lock/pid"
  c="$st/events/$(safe_name "$s").cursor"
  [ -f "$c" ] && cur="$(cat "$c")"
  cur=$(( cur + n )); [ "$cur" -lt 0 ] && cur=0
  printf '%s\n' "$cur" >"$c.tmp" && mv "$c.tmp" "$c"
  rm -rf "$lock"
  echo "$s cursor $cur"
}

# cmd_park CLI — a message that could not be sent must not wake the relay
# again at once: remember how many lines the session has, and let scan skip it
# until that number grows.
cmd_park() {
  local f
  [ -n "${1:-}" ] || { echo "usage: pr-relay park CLI_SESSION" >&2; return 64; }
  f="$(watch_state)/events/$(safe_name "$1").jsonl"
  mkdir -p "$RELAY_STATE/parked"
  wc -l <"$f" | tr -d ' ' >"$RELAY_STATE/parked/$(safe_name "$1")"
  echo "$1 parked"
}

# my_uuid — the Bitbucket account of the credential. The scoped watch token
# cannot read /user, so it is read once from the author of a watched PR.
my_uuid() {
  local cache="$RELAY_STATE/user-uuid" repo pr u
  [ -n "${PR_RELAY_USER_UUID:-}" ] && { echo "$PR_RELAY_USER_UUID"; return; }
  [ -s "$cache" ] && { cat "$cache"; return; }
  read -r repo pr <<<"$(jq -r '[.[] | select(.pr != null)] | last | "\(.repo) \(.pr)"' "$(watch_state)/subscriptions.json")"
  u="$(bb_get "$API/repositories/$repo/pullrequests/$pr" | jq -r '.author.uuid // empty')"
  [ -n "$u" ] || { echo "pr-relay: cannot learn your account uuid; set PR_RELAY_USER_UUID" >&2; return 1; }
  mkdir -p "$RELAY_STATE"; printf '%s\n' "$u" >"$cache"; echo "$u"
}

# pushed_from_repo WS/REPO ROW — true when one of the row's pushed paths is a
# clone (or a worktree of a clone) whose origin is WS/REPO. A deleted worktree
# is resolved to its main clone.
pushed_from_repo() {
  local repo="$1" path url
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    [ -d "$path" ] || path="${path%%/.claude/worktrees/*}"
    url="$(git -C "$path" remote get-url origin 2>/dev/null)" || continue
    url="${url%.git}"
    case "$url" in *[:/]"$repo") return 0 ;; esac
  done <<EOF
$(jq -r '.paths[]' <<<"$2")
EOF
  return 1
}

# owner_of REPO BRANCH PR_ID — JSON array of the desktop sessions (not
# archived) that pushed that branch, from the app's own session files:
# `prs` (a PR the app tied to the session) first, then `writtenBranches`
# ("<repo path>\0<branch>"), most recent activity first.
owner_of() {
  local repo="$1" branch="$2" id="$3" f row out='[]'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    row="$(jq -c --arg b "$branch" --arg r "${repo##*/}" --arg id "$id" '
      ([(.prs // [])[] | select(.branch == $b and (.url | test("/" + $r + "/pull-requests/" + $id + "$")))] | length > 0) as $pr
      | [(.writtenBranches // [])[] | split("\u0000") | select(.[1] == $b) | .[0]] as $wb
      | select(($pr or ($wb | length > 0)) and ((.isArchived // false) | not))
      | {local: .sessionId, cli: .cliSessionId, title: (.title // ""), last: (.lastActivityAt // 0), cites_pr: $pr, paths: $wb}' "$f" 2>/dev/null)"
    [ -n "$row" ] || continue
    # A branch name alone (staging, main) is shared by every repo: a pushed
    # branch counts only from a clone of the PR's repository.
    if [ "$(jq -r .cites_pr <<<"$row")" = false ] && ! pushed_from_repo "$repo" "$row"; then continue; fi
    is_archived "$(jq -r .local <<<"$row")" && continue
    out="$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")"
  done <<EOF
$(session_files_with "$branch")
EOF
  jq -c 'sort_by([(.cites_pr | not), -.last])' <<<"$out"
}

cmd_discover() {
  local subscribe=false st uuid ws prs open key now orphans cands chosen out='[]'
  [ "${1:-}" = --subscribe ] && subscribe=true
  load_credential || return 1
  st="$(watch_state)"
  uuid="$(my_uuid)" || return 1
  now="$(date +%s)"
  mkdir -p "$RELAY_STATE"
  orphans="$RELAY_STATE/orphans.json"
  [ -f "$orphans" ] || echo '{}' >"$orphans"
  open='[]'
  for ws in ${PR_RELAY_WORKSPACES:-$(jq -r '[.[].repo | split("/")[0]] | unique | .[]' "$st/subscriptions.json")}; do
    prs="$(bb_get -G "$API/workspaces/$ws/pullrequests/$(jq -rn --arg u "$uuid" '$u | @uri')" \
      --data-urlencode state=OPEN --data-urlencode pagelen=50)" || { echo "pr-relay: cannot list PRs of $ws" >&2; continue; }
    open="$(jq -c --argjson p "$prs" '. + [$p.values[] | {repo: .destination.repository.full_name, pr: .id, branch: .source.branch.name, title}]' <<<"$open")"
  done
  # A PR is covered by a live subscription on it, or a pending one on its branch.
  open="$(jq -c --slurpfile s "$st/subscriptions.json" '
    [.[] | . as $p
      | select([$s[0][] | select(.status != "closed" and .repo == $p.repo
          and (.pr == $p.pr or (.pr == null and .branch == $p.branch)))] | length == 0)]' <<<"$open")"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    key="$(jq -r '"\(.repo)#\(.pr)"' <<<"$p")"
    # An orphan stays one for an hour before it is looked up again.
    if [ "$(jq -r --arg k "$key" --argjson now "$now" --argjson ttl "$ORPHAN_TTL" '(.[$k] // 0) > ($now - $ttl)' "$orphans")" = true ]; then
      out="$(jq -c --argjson p "$p" '. + [$p + {owners: [], status: "orphan (cached)"}]' <<<"$out")"
      continue
    fi
    cands="$(owner_of "$(jq -r .repo <<<"$p")" "$(jq -r .branch <<<"$p")" "$(jq -r .pr <<<"$p")")"
    # The session the app tied the PR to, else the last one that pushed the branch.
    chosen="$(jq -c '.[0] // empty' <<<"$cands")"
    if [ -n "$chosen" ] && [ "$subscribe" = true ]; then
      "$(watch_cli)" subscribe "$(jq -r .repo <<<"$p")" "$(jq -r .pr <<<"$p")" \
        --session "$(jq -r .cli <<<"$chosen")" --harness claude >&2 \
        && status=subscribed || status="subscribe failed"
    elif [ -n "$chosen" ]; then status="would subscribe"
    elif [ "$subscribe" = true ]; then
      # No session owns it: the relay itself listens, under a fixed id that
      # no desktop session carries, and tells the human.
      "$(watch_cli)" subscribe "$(jq -r .repo <<<"$p")" "$(jq -r .pr <<<"$p")" \
        --session "$RELAY_INBOX" --harness relay >&2 \
        && status="subscribed to relay" || status="subscribe failed"
    else
      status=orphan
      jq --arg k "$key" --argjson now "$now" '.[$k] = $now' "$orphans" >"$orphans.tmp" && mv "$orphans.tmp" "$orphans"
    fi
    out="$(jq -c --argjson p "$p" --argjson c "$cands" --arg st "$status" '. + [$p + {owners: $c, status: $st}]' <<<"$out")"
  done <<EOF
$(jq -c '.[]' <<<"$open")
EOF
  jq . <<<"$out"
}

# sweep_state REPO PR — one coarse snapshot of a PR, from the host only:
# {state, head, url, ci{name:{state,url}}, post{...}, approved[], changes[], comments}.
# `post` is the CI of the merge commit, once the PR is merged.
sweep_state() {
  local repo="$1" pr="$2" detail head merge ci post='{}'
  detail="$(bb_get "$API/repositories/$repo/pullrequests/$pr")" || return 1
  head="$(jq -r '.source.commit.hash' <<<"$detail")"
  ci="$(bb_get "$API/repositories/$repo/commit/$head/statuses?pagelen=50" \
    | jq -c '[.values[] | {key: .name, value: {state, url}}] | from_entries')" || ci='{}'
  merge="$(jq -r '.merge_commit.hash // empty' <<<"$detail")"
  if [ -n "$merge" ] && [ "$merge" != "$head" ]; then
    post="$(bb_get "$API/repositories/$repo/commit/$merge/statuses?pagelen=50" \
      | jq -c '[.values[] | {key: .name, value: {state, url}}] | from_entries')" || post='{}'
  fi
  jq -c --argjson ci "$ci" --argjson post "$post" '{
      state, head: .source.commit.hash, branch: .source.branch.name, url: .links.html.href,
      ci: $ci, post: $post,
      approved: [.participants[] | select(.approved) | .user.display_name],
      changes: [.participants[] | select(.state == "changes_requested") | .user.display_name],
      comments: (.comment_count // 0)
    }' <<<"$detail"
}

# sweep_news PREV CUR — French one-liners for what changed between two
# snapshots. Pipelines are reported only when they end; a new head resets
# them, since the pipelines of the previous commit no longer apply.
sweep_news() {
  jq -nr --argjson p "$1" --argjson c "$2" '
    def verdict: {"SUCCESSFUL": "est passée", "FAILED": "a échoué", "STOPPED": "a été arrêtée"}[.];
    def ended($old; $new; $label):
      $new | to_entries[]
      | select(.value.state | IN("SUCCESSFUL", "FAILED", "STOPPED"))
      | select(($old[.key].state // "") != .value.state)
      | "\($label) « \(.key) » \(.value.state | verdict) · \(.value.url)";
    (if $p.head == $c.head then $p.ci else {} end) as $oldci
    | [
        (if $c.state != $p.state then
           {"MERGED": "la PR a été fusionnée", "DECLINED": "la PR a été déclinée"}[$c.state] // empty
         else empty end),
        ended($oldci; $c.ci; "la pipeline"),
        ended($p.post // {}; $c.post; "après merge, la pipeline"),
        ($c.approved - $p.approved | .[] | "approuvée par \(.)"),
        ($c.changes - $p.changes | .[] | "\(.) demande des changements"),
        (($c.comments - $p.comments) as $n
         | if $n == 1 then "un nouveau commentaire" elif $n > 1 then "\($n) nouveaux commentaires" else empty end)
      ] | .[]'
}

# bbw_covers REPO PR — true when the watcher follows this PR for a session
# whose own wait is armed right now: that session hears it from the watcher.
bbw_covers() {
  local s
  for s in $(jq -r --arg r "$1" --argjson n "$2" \
      '.[] | select(.repo == $r and .pr == $n and .status != "closed") | .session' "$(watch_state)/subscriptions.json" 2>/dev/null); do
    wait_alive "$s" && return 0
  done
  return 1
}

# sweep_owner REPO BRANCH PR — the desktop session to tell: the app's own
# record of who pushed the PR, else the watcher's subscription, else
# PR_RELAY_FALLBACK_SESSION. Prints {local, title} or nothing.
sweep_owner() {
  local o s info
  o="$(owner_of "$1" "$2" "$3" | jq -c '.[0] // empty | {local, title}')"
  [ -n "$o" ] && { echo "$o"; return; }
  for s in $(jq -r --arg r "$1" --argjson n "$3" '.[] | select(.repo == $r and .pr == $n) | .session' "$(watch_state)/subscriptions.json" 2>/dev/null); do
    info="$(ccd_session "$s")"
    [ -n "$info" ] && [ "$(jq -r .archived <<<"$info")" = false ] && { jq -c '{local, title}' <<<"$info"; return; }
  done
  [ -n "${PR_RELAY_FALLBACK_SESSION:-}" ] && jq -nc --arg l "$PR_RELAY_FALLBACK_SESSION" '{local: $l, title: "(relay)"}'
}

# cmd_sweep — one pass over the user's PRs, independent of any subscription:
# every open PR, plus the ones merged in the last PR_RELAY_MERGED_HOURS (6),
# so the destination pipeline is heard. Prints the messages to send, one per
# session; the first sight of a PR is a silent baseline.
cmd_sweep() {
  local uuid ws list prs p repo pr key snap prev cur news owner since msgs='[]' skipped='[]'
  load_credential || return 1
  uuid="$(my_uuid)" || return 1
  snap="$RELAY_STATE/sweep"; mkdir -p "$snap"
  since="$(( $(date +%s) - ${PR_RELAY_MERGED_HOURS:-6} * 3600 ))"
  list='[]'
  for ws in ${PR_RELAY_WORKSPACES:-$(jq -r '[.[].repo | split("/")[0]] | unique | .[]' "$(watch_state)/subscriptions.json")}; do
    for state in OPEN MERGED; do
      prs="$(bb_get -G "$API/workspaces/$ws/pullrequests/$(jq -rn --arg u "$uuid" '$u | @uri')" \
        --data-urlencode state="$state" --data-urlencode pagelen=50)" || { echo "pr-relay: cannot list $state PRs of $ws" >&2; continue; }
      list="$(jq -c --argjson p "$prs" --argjson since "$since" '. + [$p.values[]
        | select(.state == "OPEN" or ((.updated_on | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) > $since))
        | {repo: .destination.repository.full_name, pr: .id, branch: .source.branch.name}]' <<<"$list")"
    done
  done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    repo="$(jq -r .repo <<<"$p")"; pr="$(jq -r .pr <<<"$p")"
    key="$snap/$(safe_name "$repo#$pr").json"
    cur="$(sweep_state "$repo" "$pr")" || { echo "pr-relay: cannot read $repo#$pr" >&2; continue; }
    prev="$(cat "$key" 2>/dev/null)"
    printf '%s\n' "$cur" >"$key.tmp" && mv "$key.tmp" "$key"
    [ -n "$prev" ] || continue
    news="$(sweep_news "$prev" "$cur" | jq -Rsc 'split("\n") | map(select(. != ""))')"
    [ "$news" != "[]" ] || continue
    if bbw_covers "$repo" "$pr"; then
      skipped="$(jq -c --arg k "$repo#$pr" '. + [{pr: $k, reason: "bbw wait armed"}]' <<<"$skipped")"; continue
    fi
    owner="$(sweep_owner "$repo" "$(jq -r .branch <<<"$p")" "$pr")"
    if [ -z "$owner" ]; then
      skipped="$(jq -c --arg k "$repo#$pr" --argjson n "$news" '. + [{pr: $k, reason: "no session", news: $n}]' <<<"$skipped")"; continue
    fi
    msgs="$(jq -c --argjson o "$owner" --arg k "${repo##*/}#$pr" --arg url "$(jq -r .url <<<"$cur")" --argjson n "$news" \
      '. + [$o + {pr: $k, url: $url, news: $n}]' <<<"$msgs")"
  done <<EOF
$(jq -c 'unique_by("\(.repo)#\(.pr)") | .[]' <<<"$list")
EOF
  jq '{
    messages: (group_by(.local) | map({
      to: .[0].local, title: .[0].title,
      text: ("Point Bitbucket (routine pr-sweep) :\n"
        + (map("- \(.pr) : " + (.news | join(" ; ")) + " · \(.url)") | join("\n")))
    })),
    skipped: $skipped
  }' --argjson skipped "$skipped" <<<"$msgs"
}

cmd_wait() {
  local interval=300 scan
  [ "${1:-}" = --interval ] && interval="$2"
  while :; do
    cmd_discover --subscribe >/dev/null 2>&1 || true
    scan="$(cmd_scan)"
    if [ "$(jq '(.deliveries | length) + (.relay | length)' <<<"$scan")" -gt 0 ]; then
      printf '%s\n' "$scan"
      return 0
    fi
    sleep "$interval"
  done
}

command -v jq >/dev/null || { echo "pr-relay: jq is required" >&2; exit 1; }
case "${1:-help}" in
  scan) shift; cmd_scan "$@" ;;
  ack) shift; cmd_ack "$@" ;;
  park) shift; cmd_park "$@" ;;
  discover) shift; cmd_discover "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  sweep) shift; cmd_sweep "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 64 ;;
esac
