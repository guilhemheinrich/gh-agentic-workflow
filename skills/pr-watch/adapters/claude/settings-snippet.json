{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash ~/.agents/hooks/pr-watch-push.sh" }]
      },
      {
        "matcher": "mcp__bitbucket__add_pull_request_comment",
        "hooks": [{ "type": "command", "command": "bash ~/.agents/hooks/pr-watch-comment.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash ~/.agents/hooks/pr-watch-comment.sh" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{ "type": "command", "command": "bash ~/.agents/hooks/pr-watch-session-start.sh" }]
      }
    ]
  }
}
