#!/usr/bin/env bash
# prw — pr-watch. Wakes the agent session that owns a pull request on a Git
# host (Bitbucket Cloud, GitHub) when the PR really changes: pipeline or check
# end, comment, review, conflict, merge.
#
# Read-only on every host. bash 3.2 compatible (macOS system bash).
# Run `prw help` for the subcommands.
set -uo pipefail

# Follow symlinks (bash 3.2 has no `readlink -f` on macOS): prw is often put
# on PATH as a link, and lib/ lives next to the real file.
PRW_SELF="$0"
while [ -L "$PRW_SELF" ]; do
  link="$(readlink "$PRW_SELF")"
  case "$link" in /*) PRW_SELF="$link" ;; *) PRW_SELF="$(dirname "$PRW_SELF")/$link" ;; esac
done
case "$PRW_SELF" in /*) ;; *) PRW_SELF="$PWD/$PRW_SELF" ;; esac
PRW_LIB="$(cd "$(dirname "$PRW_SELF")/lib" && pwd)"
for lib in "$PRW_LIB"/*.sh; do
  # shellcheck disable=SC1090
  . "$lib"
done

usage() {
  cat <<'EOF'
prw — wake the session that owns a PR (Bitbucket or GitHub), once per real change.

  prw plan [--roots DIR[:DIR...]]
  prw migrate [--yes]
  prw setup [--non-interactive] [--rotate] [--github] [--claude]
  prw doctor [--quiet]
  prw subscribe (REPO PR | --branch B [--repo REPO]) --session ID [--harness NAME] [--head SHA]
  prw subscribe --commit SHA [--branch B] [--repo REPO] --session ID
  prw unsubscribe REPO (PR | --commit SHA) --session ID
  prw ignore-comment REPO PR COMMENT_ID --session ID
  prw list [--session ID]
  prw wait --session ID [--timeout S]
  prw status [--session ID | REPO PR]
  prw daemon run|once|alive|start|stop
  prw uninstall --claude
  prw --version

REPO is WS/REPO on Bitbucket, github:OWNER/REPO on GitHub.
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  --version|version) echo "prw $PRW_VERSION" ;;
  help|-h|--help) usage ;;
  *)
    fn="cmd_$(printf '%s' "$cmd" | tr '-' '_')"
    if [ "$(type -t "$fn" 2>/dev/null)" = "function" ]; then
      "$fn" "$@"
    else
      echo "prw: unknown command '$cmd'" >&2
      exit 64
    fi
    ;;
esac
