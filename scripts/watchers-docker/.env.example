# Copy to .env (never commit it) and fill in. All values below are fake.

# --- pr-watch ---------------------------------------------------------------
# Host file holding BITBUCKET_WATCH_USER / BITBUCKET_WATCH_TOKEN (and/or the
# GitHub token variables) in the format `prw setup` writes. Mounted read-only.
PRW_ENV_FILE_HOST=C:/Users/example/.config/pr-watch/env
# Non-secret tuning, optional (empty = the script's own default: 60 / 30).
PRW_POLL_SECONDS=
PRW_SETTLE_SECONDS=

# --- linear-watch -----------------------------------------------------------
# Host file holding the line LINEAR_API_KEY=... Mounted read-only.
LINEAR_ENV_FILE_HOST=C:/Users/example/.config/linear/env
# Claude Desktop sessions folder (parent of the <account>/<org>/local_*.json
# files). On Windows it is usually under %APPDATA%\Claude\claude-code-sessions.
LW_DESKTOP_DIR_HOST=C:/Users/example/AppData/Roaming/Claude/claude-code-sessions
# Non-secret tuning, optional (empty = default: 300 seconds / 7 days).
LW_POLL_SECONDS=
LW_TTL_DAYS=
