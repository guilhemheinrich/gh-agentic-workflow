#!/usr/bin/env bash
# Git Bash wrapper: run prw inside the watchers container (state lives there).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Git Bash: hand docker a Windows path, and keep it from rewriting /opt/... args.
here="$(cygpath -m "$here" 2>/dev/null || printf '%s' "$here")"
export MSYS_NO_PATHCONV=1
target=/opt/watchers/pr-watch/scripts/prw
# Stale-image guard: name the missing path instead of bash's "No such file".
if ! docker compose -f "$here/compose.yml" exec -T prw test -f "$target"; then
  echo "prw: $target is missing in the watchers container: it is not running, or its image is stale (built before the skill layout changed). Rebuild: docker compose -f $here/compose.yml up -d --build" >&2
  exit 127
fi
exec docker compose -f "$here/compose.yml" exec -T prw bash "$target" "$@"
