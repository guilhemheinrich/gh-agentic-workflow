{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"$HOME/.agents/hooks/session-title-sync.sh\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "bash \"$HOME/.agents/hooks/session-title-ask.sh\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Agent|Task|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "bash \"$HOME/.agents/hooks/session-title-progress.sh\"" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "bash \"$HOME/.agents/hooks/session-title-working.sh\"" }] }
    ]
  }
}
